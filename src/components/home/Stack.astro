---
// Stack technique : icônes servies localement (plus de requête vers un CDN tiers).
---

<section class="wm-skills">
  <p class="wm-section-eyebrow" data-i18n="// MA STACK">// MA STACK</p>
  <h2 class="wm-section-title" data-i18n-html="Ma <span class='accent'>Stack Technique</span>">
    Ma <span class="accent">Stack Technique</span>
  </h2>
  <p class="wm-section-subtitle" data-i18n="Les outils que j’utilise tous les jours pour construire, héberger et surveiller.">
    Les outils que j’utilise tous les jours pour construire, héberger et surveiller.
  </p>

  <div class="skills-matrix">
    <div class="skill-category reveal">
      <h3 data-i18n="Infra &amp; Virtualisation">Infra &amp; Virtualisation</h3>
      <div class="skills-grid">
        <div class="skill-item">
          <img src="/media/img/stack/proxmox.svg" alt="Proxmox" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">Proxmox</span>
          <div class="skill-tooltip" data-i18n="Virtualisation de mes serveurs et gestion de l'infrastructure.">Virtualisation de mes serveurs et gestion de l'infrastructure.</div>
        </div>
        <div class="skill-item">
          <img src="/media/img/stack/docker.svg" alt="Docker" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">Docker</span>
          <div class="skill-tooltip" data-i18n="Conteneurisation et déploiement de tous mes services.">Conteneurisation et déploiement de tous mes services.</div>
        </div>
        <div class="skill-item">
          <img src="/media/img/stack/ubuntu.svg" alt="Ubuntu" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">Ubuntu Linux</span>
          <div class="skill-tooltip" data-i18n="Administration serveur quotidienne en ligne de commande.">Administration serveur quotidienne en ligne de commande.</div>
        </div>
      </div>
    </div>

    <div class="skill-category reveal">
      <h3 data-i18n="Monitoring &amp; Automatisation">Monitoring &amp; Automatisation</h3>
      <div class="skills-grid">
        <div class="skill-item">
          <img src="/media/img/stack/n8n.svg" alt="n8n" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">n8n</span>
          <div class="skill-tooltip" data-i18n="Création de workflows d'auto-healing et notifications.">Création de workflows d'auto-healing et notifications.</div>
        </div>
        <div class="skill-item">
          <img src="/media/img/stack/git.svg" alt="Git" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">Git</span>
          <div class="skill-tooltip" data-i18n="Versionnage de mes configurations.">Versionnage de mes configurations.</div>
        </div>
      </div>
    </div>

    <div class="skill-category reveal">
      <h3 data-i18n="Services &amp; Hébergement">Services &amp; Hébergement</h3>
      <div class="skills-grid">
        <div class="skill-item">
          <img src="/media/img/stack/caddy.svg" alt="Caddy" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">Caddy</span>
          <div class="skill-tooltip" data-i18n="Gestion des accès externes sécurisés.">Gestion des accès externes sécurisés.</div>
        </div>
        <div class="skill-item">
          <img src="/media/img/stack/cloudflare.svg" alt="Cloudflare" class="skill-icon" width="32" height="32" loading="lazy" decoding="async">
          <span class="skill-name">Cloudflare</span>
          <div class="skill-tooltip" data-i18n="Sécurisation DNS, cache, certificats SSL et tunnels.">Sécurisation DNS, cache, certificats SSL et tunnels.</div>
        </div>
      </div>
    </div>
  </div>
</section>
