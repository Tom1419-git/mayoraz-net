---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
---

<Layout title="Mes Liens | Thomas Mayoraz" description="Retrouvez tous mes liens utiles : GitHub, LinkedIn, Instagram et Contact." cssFile="/media/css/links.css">
    <div class="links-container reveal">
        <a href="/" class="back-nav" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
        <div class="profile-section">
            <div class="avatar links-avatar">TM</div>
            <h1>Thomas Mayoraz</h1>
            <p class="tagline">@th0m4s_stfu</p>
        </div>

        <div class="links-list">
            <a href="https://github.com/Tom1419-git" target="_blank" rel="noopener noreferrer" class="link-btn github">
                <span class="icon">💻</span>
                GitHub
            </a>
            <a href="https://www.linkedin.com/in/thomas-mayoraz-it/" target="_blank" rel="noopener noreferrer" class="link-btn linkedin">
                <span class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></span>
                LinkedIn
            </a>
            <a href="https://www.instagram.com/th0m4s_stfu?igsh=MXNhMDB5eTJ5MzQxOQ%3D%3D&utm_source=qr" target="_blank" rel="noopener noreferrer" class="link-btn instagram">
                <span class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg></span>
                Instagram
            </a>
            <a href="/jeu/" class="link-btn quiz">
                <span class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/></svg></span>
                <span data-i18n="Quiz Tech : testez vos connaissances">Quiz Tech : testez vos connaissances</span>
            </a>
            <a href="/contact/" class="link-btn contact">
                <span class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                Contact
            </a>
        </div>
    </div>
</Layout>
