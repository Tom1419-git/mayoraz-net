---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sites Web - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Sites Web - Thomas Mayoraz | Services Informatiques Lausanne" description="Mes réalisations de développement web : sites vitrines, applications et solutions digitales. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">
                <div class="avatar" style="width: 100px; height: 100px; margin: 0 auto 20px; border-radius: 50%; overflow: hidden; border: 2px solid var(--glass-border);">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <p class="wm-section-eyebrow" data-i18n="Sites Web">Sites Web</p>
                <h1 class="wm-section-title" data-i18n-html="Mes créations <span class='accent'>digitales</span>">Mes créations <span class="accent">digitales</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px;" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main style="max-width: 1000px; margin: 0 auto 60px;">
            <section class="wm-card" style="padding: 30px; margin-bottom: 40px; text-align: center;">
                <p style="color: var(--text-heading); line-height: 1.7; font-size: 1.1rem; margin-bottom: 20px;" data-i18n="Découvrez mes projets de développement web, des sites vitrines aux applications interactives. Chaque création reflète ma passion pour le web moderne et l'expérience utilisateur.">Découvrez mes projets de développement web, des sites vitrines aux applications interactives. Chaque création reflète ma passion pour le web moderne et l'expérience utilisateur.</p>
                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 15px; border-radius: 8px; text-align: left;">
                    <h3 style="color: var(--text-heading); font-size: 1rem; margin-bottom: 5px;" data-i18n="💡 Navigation">💡 Navigation</h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem;" data-i18n="Pour revenir à cette page depuis un site, rendez-vous en pied de page d'accueil de chaque site et cliquez sur le bouton de retour au portfolio.">Pour revenir à cette page depuis un site, rendez-vous en pied de page d'accueil de chaque site et cliquez sur le bouton de retour au portfolio.</p>
                </div>
            </section>

            <div class="wm-bento-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
                <a class="wm-bento-cell" href="/sites-web/ctt_montriond_version_club/" style="display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <span style="font-size: 2.5rem;">🏓</span>
                        <div>
                            <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 4px 0;" data-i18n="CTT Montriond Ouchy">CTT Montriond Ouchy</h3>
                            <p style="color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0;" data-i18n="Projet d'apprentissage">Projet d'apprentissage</p>
                            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;" data-i18n="Mai 2025">Mai 2025</p>
                        </div>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Site web que j'ai développé pour mon club de ping-pong, le CTT Montriond Ouchy. Interface moderne et responsive présentant les actualités du club, les équipes, les résultats des matchs et les informations pratiques pour les membres et nouveaux joueurs.">
                        Site web que j'ai développé pour mon club de ping-pong, le CTT Montriond Ouchy. Interface moderne et responsive présentant les actualités du club, les équipes, les résultats des matchs et les informations pratiques pour les membres et nouveaux joueurs.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">HTML5</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">CSS3</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Responsive">Responsive</span>
                    </div>
                </a>

                <a class="wm-bento-cell" href="/" style="display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <span style="font-size: 2.5rem;">👨‍💻</span>
                        <div>
                            <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 4px 0;" data-i18n="Portfolio Personnel">Portfolio Personnel</h3>
                            <p style="color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0;">mayoraz-net.ch</p>
                            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;" data-i18n="Juin 2026">Juin 2026</p>
                        </div>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Mon propre site web vitrine et portfolio professionnel. Conçu de A à Z pour présenter mes services informatiques, mes réalisations et faciliter la prise de contact grâce à un design moderne, réactif et optimisé.">
                        Mon propre site web vitrine et portfolio professionnel. Conçu de A à Z pour présenter mes services informatiques, mes réalisations et faciliter la prise de contact grâce à un design moderne, réactif et optimisé.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">HTML5</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">CSS3</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">JavaScript</span>
                    </div>
                </a>

                <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <span style="font-size: 2.5rem;">🦷</span>
                        <div>
                            <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 4px 0;" data-i18n="Cabinet Dentaire Tivoli">Cabinet Dentaire Tivoli</h3>
                            <p style="color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0;" data-i18n="Plateforme de gestion">Plateforme de gestion</p>
                            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;" data-i18n="Février 2026">Février 2026</p>
                        </div>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Développement d'une solution logicielle complète pour un cabinet dentaire. Réalisation d'une plateforme de gestion des patients et création d'un modèle de facturation automatisé sur mesure pour optimiser l'administration du cabinet.">
                        Développement d'une solution logicielle complète pour un cabinet dentaire. Réalisation d'une plateforme de gestion des patients et création d'un modèle de facturation automatisé sur mesure pour optimiser l'administration du cabinet.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">C#</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Base de données">Base de données</span>
                    </div>
                </div>

                <a class="wm-bento-cell" href="https://facture.mayoraz-net.ch" target="_blank" rel="noopener noreferrer" style="display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <span style="font-size: 2.5rem;">🧾</span>
                        <div>
                            <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 4px 0;" data-i18n="FactureArtisan">FactureArtisan</h3>
                            <p style="color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0;">facture.mayoraz-net.ch</p>
                            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;" data-i18n="Juillet 2026">Juillet 2026</p>
                        </div>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Générateur de factures PDF professionnel pour artisans et indépendants suisses. Gratuit pour les 3 premières factures, avec logo personnalisable, format enveloppe suisse (C5) et TVA 8.1% intégrée. Version Pro disponible.">
                        Générateur de factures PDF professionnel pour artisans et indépendants suisses. Gratuit pour les 3 premières factures, avec logo personnalisable, format enveloppe suisse (C5) et TVA 8.1% intégrée. Version Pro disponible.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Astro</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">React</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Supabase</span>
                    </div>
                </a>

                <div class="wm-bento-cell" style="display: flex; align-items: center; justify-content: center; min-height: 200px; border: 1px dashed rgba(255,255,255,0.2); background: transparent;">
                    <div style="text-align: center;">
                        <div style="font-size: 2rem; color: var(--accent); margin-bottom: 10px;">+</div>
                        <p style="color: var(--text-muted); font-size: 0.9rem;" data-i18n="Prochain projet en cours...">Prochain projet en cours...</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Sites Web",
        "description": "Collection de sites web développés par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/sites-web/",
        "numberOfItems": 4,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "WebSite",
                    "name": "CTT Montriond Ouchy",
                    "url": "https://mayoraz-net.ch/sites-web/ctt_montriond_version_club/index.html"
                }
            }
        ]
    }
    </script>
    </Fragment>
</Layout>
