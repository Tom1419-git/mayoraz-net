---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sites Web - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Sites Web - Thomas Mayoraz | Services Informatiques Lausanne" description="Mes réalisations de développement web : sites vitrines, applications et solutions digitales. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">
                <div class="avatar">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" />
                    <div class="avatar-fallback">TM</div>
                </div>
                <h1 data-i18n="Sites Web">Sites Web</h1>
                <p class="subtitle" data-i18n="Mes créations digitales et expériences web">Mes créations digitales et expériences web</p>
                <a class="back-nav" href="/" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main>
            <section class="intro reveal">
                <p data-i18n="Découvrez mes projets de développement web, des sites vitrines aux applications interactives. Chaque création reflète ma passion pour le web moderne et l'expérience utilisateur.">Découvrez mes projets de développement web, des sites vitrines aux applications interactives. Chaque création reflète ma passion pour le web moderne et l'expérience utilisateur.</p>
            </section>

            <div class="navigation-info">
                <h3 data-i18n="💡 Navigation">💡 Navigation</h3>
                <p data-i18n="Pour revenir à cette page depuis un site, rendez-vous en pied de page d'accueil de chaque site et cliquez sur le bouton de retour au portfolio.">Pour revenir à cette page depuis un site, rendez-vous en pied de page d'accueil de chaque site et cliquez sur le bouton de retour au portfolio.</p>
            </div>

            <div class="sites-grid">
                <a class="site-card reveal" href="../sites-web/ctt_montriond_version_club/index.html">
                   
                    <div class="site-header">
                        <span class="site-icon">🏓</span>
                        <div>
                            <h3 class="site-title">CTT Montriond Ouchy</h3>
                            <p class="site-url" data-i18n="Projet d'apprentissage">Projet d'apprentissage</p>
                            <p class="project-date" data-i18n="Mai 2025">Mai 2025</p>
                        </div>
                    </div>
                    <p class="site-description" data-i18n="Site web que j'ai développé pour mon club de ping-pong, le CTT Montriond Ouchy. Interface moderne et responsive présentant les actualités du club, les équipes, les résultats des matchs et les informations pratiques pour les membres et nouveaux joueurs.">
                        Site web que j'ai développé pour mon club de ping-pong, le CTT Montriond Ouchy. Interface moderne et responsive présentant les actualités du club, les équipes, les résultats des matchs et les informations pratiques pour les membres et nouveaux joueurs.
                    </p>
                    <div class="site-tech">
                        <span class="tech-tag">HTML5</span>
                        <span class="tech-tag">CSS3</span>
                        <span class="tech-tag" data-i18n="Responsive">Responsive</span>
                    </div>
                </a>

                <a class="site-card reveal" href="/">
                    <div class="site-header">
                        <span class="site-icon">👨‍💻</span>
                        <div>
                            <h3 class="site-title" data-i18n="Portfolio Personnel">Portfolio Personnel</h3>
                            <p class="site-url">mayoraz-net.ch</p>
                            <p class="project-date" data-i18n="Juin 2026">Juin 2026</p>
                        </div>
                    </div>
                    <p class="site-description" data-i18n="Mon propre site web vitrine et portfolio professionnel. Conçu de A à Z pour présenter mes services informatiques, mes réalisations et faciliter la prise de contact grâce à un design moderne, réactif et optimisé.">
                        Mon propre site web vitrine et portfolio professionnel. Conçu de A à Z pour présenter mes services informatiques, mes réalisations et faciliter la prise de contact grâce à un design moderne, réactif et optimisé.
                    </p>
                    <div class="site-tech">
                        <span class="tech-tag">HTML5</span>
                        <span class="tech-tag">CSS3</span>
                        <span class="tech-tag">JavaScript</span>
                        <span class="tech-tag">Turnstile</span>
                    </div>
                </a>

                <div class="site-card reveal">
                    <div class="site-header">
                        <span class="site-icon">🦷</span>
                        <div>
                            <h3 class="site-title" data-i18n="Cabinet Dentaire Tivoli">Cabinet Dentaire Tivoli</h3>
                            <p class="site-url" data-i18n="Plateforme de gestion">Plateforme de gestion</p>
                            <p class="project-date" data-i18n="Février 2026">Février 2026</p>
                        </div>
                    </div>
                    <p class="site-description" data-i18n="Développement d'une solution logicielle complète pour un cabinet dentaire. Réalisation d'une plateforme de gestion des patients et création d'un modèle de facturation automatisé sur mesure pour optimiser l'administration du cabinet.">
                        Développement d'une solution logicielle complète pour un cabinet dentaire. Réalisation d'une plateforme de gestion des patients et création d'un modèle de facturation automatisé sur mesure pour optimiser l'administration du cabinet.
                    </p>
                    <div class="site-tech">
                        <span class="tech-tag">C#</span>
                        <span class="tech-tag" data-i18n="Base de données">Base de données</span>
                        <span class="tech-tag" data-i18n="Génération PDF">Génération PDF</span>
                        <span class="tech-tag">UI/UX</span>
                    </div>
                </div>

                <div class="add-site-card">
                    <div class="add-icon">+</div>
                    <p class="add-text" data-i18n="Prochain projet en cours...">Prochain projet en cours...</p>
                </div>
            </div>
        </main>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Sites Web",
        "description": "Collection de sites web développés par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/sites-web/",
        "numberOfItems": 1,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "WebSite",
                    "name": "CTT Montriond Ouchy",
                    "url": "https://mayoraz-net.ch/sites-web/ctt_montriond_version_club/index.html"
                }
            }
        ]
    }
    </script>
    </Fragment>
</Layout>
