                    </div>
                    <div class="project-actions">
                        <span class="download-btn" style="background: var(--glass-bg); border: 1px solid var(--glass-border); pointer-events: none;">🔗 facture.mayoraz-net.ch</span>
                    </div>
                </a>

                <div class="add-project-card">
                    <div class="add-icon">+</div>
                    <p class="add-text" data-i18n="Nouveaux projets techniques en préparation...">Nouveaux projets techniques en préparation...</p>
                </div>
