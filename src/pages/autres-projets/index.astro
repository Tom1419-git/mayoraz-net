                        <span class="tech-tag">Excel</span>
                        <span class="tech-tag">PowerPoint</span>
                        <span class="tech-tag">Outlook</span>
                        <span class="tech-tag" data-i18n="Guide">Guide</span>
                    </div>
                    <div class="cote">
                    <div class="project-actions">
                        <a href="media/Guide_Office_ThomasMayoraz.7z" class="download-btn" download="" data-i18n="📦 Télécharger le dossier ZIP">
                            📦 Télécharger le dossier ZIP
                        </a>
                    </div>
                     <div class="project-actions">
                        <a href="media/ThomasMayoraz_Guide_Office.docx" class="download-btn" download="" data-i18n="📄 Télécharger le Rapport">
                            📄 Télécharger le Rapport
                        </a>
                    </div>
                    </div>
                </div>

                <a class="project-card reveal" href="https://facture.mayoraz-net.ch" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit;">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">🧾</span>
                            <div>
                                <h3 class="project-title">FactureArtisan</h3>
                                <p class="project-type" data-i18n="SaaS Web">SaaS Web</p>
