                        <span class="tech-tag">PowerShell</span>
                        <span class="tech-tag">Remoting</span>
                        <span class="tech-tag" data-i18n="Collecte de données">Collecte de données</span>
                        <span class="tech-tag" data-i18n="Automatisation">Automatisation</span>
                        <span class="tech-tag" data-i18n="Rapports">Rapports</span>
                    </div>
