---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Autres Projets - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Autres Projets - Thomas Mayoraz | Services Informatiques Lausanne" description="Découvrez mes autres projets : virtualisation, scripts PowerShell, MQTT et guides techniques. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">                <h1 data-i18n="Autres Projets">Autres Projets</h1>
                <p class="subtitle" data-i18n="Virtualisation, Scripts &amp; Guides Techniques">Virtualisation, Scripts &amp; Guides Techniques</p>
                <a class="back-nav" href="/" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main>
            <section class="intro reveal">
                <p data-i18n="Découvrez mes projets techniques incluant des rapports de virtualisation, scripts PowerShell, implémentations MQTT et guides détaillés. Chaque projet est documenté avec soin et disponible en téléchargement.">Découvrez mes projets techniques incluant des rapports de virtualisation, scripts PowerShell, implémentations MQTT et guides détaillés. Chaque projet est documenté avec soin et disponible en téléchargement.</p>
