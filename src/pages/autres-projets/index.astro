                        <span class="tech-tag" data-i18n="Réseau">Réseau</span>
                    </div>
                    <div class="project-actions">
                        <a href="media/R-216-thomayoraz-Rapport_Projet_MQTT.docx" class="download-btn" download="" data-i18n="📄 Rapport Technique">
                            📄 Rapport Technique
                        </a>
                    </div>
                </div>

                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">📊</span>
                            <div>
                                <h3 class="project-title" data-i18n="Guide VirtualBox">Guide VirtualBox</h3>
