---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Autres Projets - Thomas Mayoraz | Services Informatiques Lausanne" description="Découvrez mes autres projets : virtualisation, scripts PowerShell, MQTT et guides techniques. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">
                <div class="avatar">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" />
                    <div class="avatar-fallback">TM</div>
                </div>
                <h1 data-i18n="Autres Projets">Autres Projets</h1>
                <p class="subtitle">Virtualisation, Scripts &amp; Guides Techniques</p>
                <a class="back-nav" href="/">← Retour au Portfolio</a>
            </div>
        </header>

        <main>
            <section class="intro reveal">
                <p>Découvrez mes projets techniques incluant des rapports de virtualisation, scripts PowerShell, implémentations MQTT et guides détaillés. Chaque projet est documenté avec soin et disponible en téléchargement.</p>
            </section>

            <div class="projects-grid">
                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">🖥️</span>
                            <div>
                                <h3 class="project-title">Virtualisation Win11 &amp; Ubuntu</h3>
                                <p class="project-type">Projet de Virtualisation</p>
                                <p class="project-date">Janvier 2025</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description">
                        Rapport complet sur la création et configuration de deux machines virtuelles (Windows 11 et Ubuntu) avec VirtualBox. Guide détaillé d'installation, configuration réseau, partage de fichiers et optimisation des performances.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag">VirtualBox</span>
                        <span class="tech-tag">Windows 11</span>
                        <span class="tech-tag">Ubuntu</span>
                        <span class="tech-tag">Virtualisation</span>
                        <span class="tech-tag" data-i18n="Réseau">Réseau</span>
                    </div>
                    <div class="project-actions">
                        <a href="media/X_SYS-187_ThomasMayoraz_RapportFinal.pdf" class="download-btn" download="">
                            📄 Télécharger le Rapport
                        </a>
                    </div>
                </div>

                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">💻</span>
                            <div>
                                <h3 class="project-title">Script PowerShell de Collecte</h3>
                                <p class="project-type">Automatisation</p>
                                <p class="project-date" data-i18n="Juin 2025">Juin 2025</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description">
                        Script PowerShell avancé permettant la collecte de données système sur plusieurs machines via le remoting. Fonctionnalités incluant la génération de rapports, l'export en CSV et la détection d'anomalies. Documentation complète incluse.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag" data-i18n="PowerShell">PowerShell</span>
                        <span class="tech-tag">Remoting</span>
                        <span class="tech-tag">Collecte de données</span>
                        <span class="tech-tag">Automatisation</span>
                        <span class="tech-tag">Rapports</span>
                    </div>
                    <div class="cote">
                    <div class="project-actions">
                        <a href="media/122-Script_Projet_InfoLogger.ps1" class="download-btn" download="">
                            📦 Télécharger le Script
                        </a>
                    </div>
                    <div class="project-actions">
                    <a href="media/R-122-ervlemqadem-thomayoraz-Rapport_Pscript_Sysinfologger.docx" class="download-btn" download="">
                            📄 Télécharger le Rapport
                    </a>
                    </div>
                    </div>
                </div>

                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">📶</span>
                            <div>
                                <h3 class="project-title">Projet MQTT sur VM</h3>
                                <p class="project-type">IoT &amp; Messagerie</p>
                                <p class="project-date">Avril 2025</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description">
                        Implémentation d'un système de messagerie MQTT entre plusieurs machines virtuelles. Rapport détaillant l'installation de Mosquitto MQTT, la configuration des brokers/clients, la sécurité et des cas d'utilisation pratiques avec exemples de code.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag">MQTT</span>
                        <span class="tech-tag">Mosquitto</span>
                        <span class="tech-tag">IoT</span>
                        <span class="tech-tag">Virtualisation</span>
                        <span class="tech-tag" data-i18n="Réseau">Réseau</span>
                    </div>
                    <div class="project-actions">
                        <a href="media/R-216-thomayoraz-Rapport_Projet_MQTT.docx" class="download-btn" download="">
                            📄 Rapport Technique
                        </a>
                    </div>
                </div>

                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">📊</span>
                            <div>
                                <h3 class="project-title">Guide VirtualBox</h3>
                                <p class="project-type">Présentation</p>
                                <p class="project-date">Décembre 2024</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description">
                        Présentation PowerPoint complète guidant pas à pas l'installation et la configuration de VirtualBox. Contenu visuel avec captures d'écran, astuces d'optimisation et bonnes pratiques. Parfait pour former des débutants à la virtualisation.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag">VirtualBox</span>
                        <span class="tech-tag">PowerPoint</span>
                        <span class="tech-tag">Guide</span>
                        <span class="tech-tag">Formation</span>
                    </div>
                    <div class="project-actions">
                        <a href="media/P-187-thomayoraz-GuideInstalationVM.pptx" class="download-btn" download="">
                            📊 Télécharger la Présentation
                        </a>
                    </div>
                </div>

                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">📝</span>
                            <div>
                                <h3 class="project-title">Guide Office 365</h3>
                                <p class="project-type" data-i18n="Documentation">Documentation</p>
                                <p class="project-date">Janvier 2025</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description">
                        Documentation complète sur Word, Excel, Outlook et PowerPoint incluant des guides détaillés, astuces et bonnes pratiques. Le fichier ZIP contient des exemples pratiques, des modèles réutilisables et des démonstrations étape par étape.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag">Office 365</span>
                        <span class="tech-tag">Word</span>
                        <span class="tech-tag">Excel</span>
                        <span class="tech-tag">PowerPoint</span>
                        <span class="tech-tag">Outlook</span>
                        <span class="tech-tag">Guide</span>
                    </div>
                    <div class="cote">
                    <div class="project-actions">
                        <a href="media/Guide_Office_ThomasMayoraz.7z" class="download-btn" download="">
                            📦 Télécharger le dossier ZIP
                        </a>
                    </div>
                     <div class="project-actions">
                        <a href="media/ThomasMayoraz_Guide_Office.docx" class="download-btn" download="">
                            📄 Télécharger le Rapport
                        </a>
                    </div>
                    </div>
                </div>

                <div class="add-project-card">
                    <div class="add-icon">+</div>
                    <p class="add-text">Nouveaux projets techniques en préparation...</p>
                </div>
            </div>
        </main>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Autres Projets",
        "description": "Collection de projets techniques et guides par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/autres-projets/",
        "numberOfItems": 5,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "TechArticle",
                    "name": "Projet de Virtualisation Win11/Ubuntu",
                    "description": "Guide complet d'installation de deux machines virtuelles",
                    "keywords": "virtualisation, windows 11, ubuntu, virtualbox"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "TechArticle",
                    "name": "Script PowerShell pour la Collecte de Données",
                    "description": "Script avancé utilisant le remoting PowerShell",
                    "keywords": "powershell, remoting, collecte données, automatisation"
                }
            },
            {
                "@type": "ListItem",
                "position": 3,
                "item": {
                    "@type": "TechArticle",
                    "name": "Projet MQTT sur Machines Virtuelles",
                    "description": "Implémentation d'un système de messagerie MQTT",
                    "keywords": "mqtt, iot, virtualisation, messagerie"
                }
            },
            {
                "@type": "ListItem",
                "position": 4,
                "item": {
                    "@type": "TechArticle",
                    "name": "Guide d'Installation VirtualBox",
                    "description": "Présentation PowerPoint complète pour VirtualBox",
                    "keywords": "virtualbox, guide, installation, présentation"
                }
            },
            {
                "@type": "ListItem",
                "position": 5,
                "item": {
                    "@type": "TechArticle",
                    "name": "Guide Office 365",
                    "description": "Documentation complète sur Word, Excel et PowerPoint",
                    "keywords": "office 365, guide, word, excel, powerpoint"
                }
            }
        ]
    }
    </script>
    </Fragment>
</Layout>
