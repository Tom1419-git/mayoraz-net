            <section style="margin-bottom: 55px;">
                <h2 class="wm-section-title" style="font-size:1.5rem; margin-bottom: 8px; text-align:center;" data-i18n-html="Ce que ça <span class='accent'>change</span> vraiment">Ce que ça <span class="accent">change</span> vraiment</h2>
