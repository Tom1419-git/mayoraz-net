---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="À Propos - Thomas Mayoraz | Services Informatiques Lausanne" description="Découvrez mon parcours, mes compétences et ma passion pour l'informatique. Thomas Mayoraz, expert en services informatiques à Lausanne." cssFile="/media/css/a-propos.css">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">
                <div class="avatar">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" />
                    <div class="avatar-fallback">TM</div>
                </div>
                <h1 data-i18n="À propos de moi">À propos de moi</h1>
                <p class="subtitle" data-i18n="Apprenti informaticien passionné">Apprenti informaticien passionné</p>
                <a class="back-nav" href="/" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>



        <main>

            <section class="intro reveal">

                <p data-i18n="Bonjour ! Je m'appelle Thomas Mayoraz, j'ai 17 ans et je suis actuellement en 2ème année d'apprentissage informaticien (voie Infra avec Maturité) à l'ETML à Lausanne. Passionné par l'informatique depuis tout petit, j'ai décidé de faire de cette passion un métier.">Bonjour ! Je m'appelle Thomas Mayoraz, j'ai 17 ans et je suis actuellement en 2ème année d'apprentissage informaticien (voie Infra avec Maturité) à l'ETML à Lausanne. Passionné par l'informatique depuis tout petit, j'ai décidé de faire de cette passion un métier.</p>

                <p data-i18n="Mon parcours scolaire à l'ETML m'a permis d'acquérir des bases solides en programmation, administration réseau, gestion de bases de données et montage PC. Mais ce n'est qu'un début : je continue à apprendre chaque jour grâce à mes projets personnels, mes lectures techniques et mes collaborations.">Mon parcours scolaire à l'ETML m'a permis d'acquérir des bases solides en programmation, administration réseau, gestion de bases de données et montage PC. Mais ce n'est qu'un début : je continue à apprendre chaque jour grâce à mes projets personnels, mes lectures techniques et mes collaborations.</p>

                <div class="info-box">
                    <strong data-i18n="💻 Pour les curieux et les terminaux-addicts :">💻 Pour les curieux et les terminaux-addicts :</strong><br>
                    <span data-i18n="Essayez cette commande dans votre terminal :">Essayez cette commande dans votre terminal :</span> <br>
                    <code class="cli-code">curl https://mayoraz-net.ch/api/cv.json</code>
                </div>

            </section>



            <section class="skills">

                <h2 data-i18n="Mes Compétences">Mes Compétences</h2>

                                <div class="skills-container">

                    <div class="skill-bar-wrapper reveal">

                        <div class="skill-info">

                            <span data-i18n="Administration Réseau &amp; Serveurs">Administration Réseau &amp; Serveurs</span>

                            <span>90%</span>

                        </div>

                        <div class="skill-bar">

                            <div class="skill-progress" data-width="90%"></div>

                        </div>

                    </div>

                    

                    <div class="skill-bar-wrapper reveal">

                        <div class="skill-info">

                            <span data-i18n="Hardware, Montage PC &amp; Dépannage">Hardware, Montage PC &amp; Dépannage</span>

                            <span>95%</span>

                        </div>

                        <div class="skill-bar">

                            <div class="skill-progress" data-width="95%"></div>

                        </div>

                    </div>

                    

                    <div class="skill-bar-wrapper reveal">

                        <div class="skill-info">

                            <span data-i18n="Systèmes d'Exploitation &amp; Sécurité">Systèmes d'Exploitation &amp; Sécurité</span>

                            <span>85%</span>

                        </div>

                        <div class="skill-bar">

                            <div class="skill-progress" data-width="85%"></div>

                        </div>

                    </div>

                    

                    <div class="skill-bar-wrapper reveal">

                        <div class="skill-info">

                            <span data-i18n="Scripting &amp; Développement Web">Scripting &amp; Développement Web</span>

                            <span>75%</span>

                        </div>

                        <div class="skill-bar">

                            <div class="skill-progress" data-width="75%"></div>

                        </div>

                    </div>

                </div>

            </section>



            <section class="cta-banner">

                <h2 data-i18n="Prêt à collaborer ?">Prêt à collaborer ?</h2>

                <p data-i18n="Contactez-moi dès maintenant pour discuter de votre projet informatique, que ce soit un site web, un montage PC ou une assistance technique.">Contactez-moi dès maintenant pour discuter de votre projet informatique, que ce soit un site web, un montage PC ou une assistance technique.</p>

                <div class="social-links-container">
                    <a class="cta-button" href="/contact/" data-i18n="Me Contacter">Me Contacter</a>
                    <a href="https://www.linkedin.com/in/thomas-mayoraz-it/" target="_blank" rel="noopener noreferrer" class="social-btn social-linkedin">
                        <svg height="24" width="24" viewBox="0 0 24 24" fill="white">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                        </svg>
                        <span data-i18n="Mon LinkedIn">Mon LinkedIn</span>
                    </a>
                </div>

            </section>

            <section class="easter-eggs reveal" style="margin-top: 60px; font-size: 0.85em; opacity: 0.7; border-top: 1px dashed var(--border-color); padding-top: 20px;">
                <h3 style="margin-bottom: 10px; font-size: 1.1em;" data-i18n="🤫 Secrets &amp; Easter Eggs">🤫 Secrets &amp; Easter Eggs</h3>
                <p data-i18n="Ce site cache quelques secrets pour les plus curieux :">Ce site cache quelques secrets pour les plus curieux :</p>
                <ul style="list-style-type: disc; margin-left: 20px; line-height: 1.6;">
                    <li><strong data-i18n="Konami Code :">Konami Code :</strong> <span data-i18n="Haut, Haut, Bas, Bas, Gauche, Droite, Gauche, Droite, B, A">Haut, Haut, Bas, Bas, Gauche, Droite, Gauche, Droite, B, A</span></li>
                    <li><strong data-i18n="Terminal caché :">Terminal caché :</strong> <span data-i18n="Appuyez sur Shift + F10 n'importe où sur le site">Appuyez sur <code>Shift + F10</code> n'importe où sur le site</span></li>
                    <li><strong data-i18n="API :">API :</strong> <code>curl https://mayoraz-net.ch/api/cv.json</code></li>
                </ul>
            </section>

        </main>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>

    {

        "@context": "https://schema.org",

        "@type": "Person",

        "name": "Thomas Mayoraz",

        "jobTitle": "Apprenti Informatique",

        "url": "https://mayoraz-net.ch",

        "sameAs": ["https://github.com/Tom1419-git", "https://mayoraz-net.ch"],

        "worksFor": {

            "@type": "Organization",

            "name": "ETML Lausanne"

        }

    }

    </script>
    </Fragment>
</Layout>
