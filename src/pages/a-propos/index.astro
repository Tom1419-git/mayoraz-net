---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="À Propos - Thomas Mayoraz | Services Informatiques Lausanne" description="Découvrez mon parcours, mes compétences et ma passion pour l'informatique. Thomas Mayoraz, expert en services informatiques à Lausanne." cssFile="/media/css/a-propos.css">
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">
                <p class="wm-section-eyebrow" data-i18n="Apprenti informaticien passionné">Apprenti informaticien passionné</p>
                <h1 class="wm-section-title" data-i18n="À propos de moi">À propos de <span class="accent">moi</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px;" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main>
           <section class="wm-card" style="padding: 40px; max-width: 800px; margin: 0 auto 60px;">
                <p id="about-intro" style="font-size: 1.1rem; line-height: 1.7; color: var(--text-heading); margin-bottom: 20px;">
                    <span data-i18n="Bonjour ! Je m'appelle Thomas Mayoraz, j'ai ">Bonjour ! Je m'appelle Thomas Mayoraz, j'ai </span><span id="dynamic-age" class="accent" style="font-weight: 700;">17</span><span data-i18n=" ans et je suis actuellement en "> ans et je suis actuellement en </span><span id="dynamic-year" class="accent" style="font-weight: 700;">3ème</span><span data-i18n=" année d'apprentissage informaticien (voie Infra avec Maturité) à l'ETML à Lausanne. Passionné par l'informatique depuis tout petit, j'ai décidé de faire de cette passion un métier."> année d'apprentissage informaticien (voie Infra avec Maturité) à l'ETML à Lausanne. Passionné par l'informatique depuis tout petit, j'ai décidé de faire de cette passion un métier.</span>
                </p>

                <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 20px;" data-i18n="Mon parcours scolaire à l'ETML m'a permis d'acquérir des bases solides en programmation, administration réseau, gestion de bases de données et montage PC. Mais ce n'est qu'un début : je continue à apprendre chaque jour grâce à mes projets personnels, mes lectures techniques et mes collaborations.">Mon parcours scolaire à l'ETML m'a permis d'acquérir des bases solides en programmation, administration réseau, gestion de bases de données et montage PC. Mais ce n'est qu'un début : je continue à apprendre chaque jour grâce à mes projets personnels, mes lectures techniques et mes collaborations.</p>

                <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 20px;" data-i18n-html="En dehors de l'école, je conçois et j'exploite un <strong style='color: var(--accent);'>homelab de niveau production</strong> : 11 conteneurs dédiés sur Proxmox, SSO avec 2FA, sauvegardes chiffrées testées par des restaurations réelles, auto-réparation et tunnel de secours prêt à basculer 16 sites. J'y ai développé <strong style='color: var(--accent);'>Vektor</strong>, un assistant IA qui pilote cette infrastructure en langage naturel (double confirmation obligatoire, CI/CD, 157 tests), ainsi qu'un indexeur DHT self-hosted de ~200 000 torrents avec taggage automatique.">En dehors de l'école, je conçois et j'exploite un <strong style="color: var(--accent);">homelab de niveau production</strong> : 11 conteneurs dédiés sur Proxmox, SSO avec 2FA, sauvegardes chiffrées testées par des restaurations réelles, auto-réparation et tunnel de secours prêt à basculer 16 sites. J'y ai développé <strong style="color: var(--accent);">Vektor</strong>, un assistant IA qui pilote cette infrastructure en langage naturel (double confirmation obligatoire, CI/CD, 157 tests), ainsi qu'un indexeur DHT self-hosted de ~200 000 torrents avec taggage automatique.</p>

                <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px;">
                    <a href="/homelab/" style="display: inline-block; padding: 6px 12px; background: rgba(79, 143, 255, 0.1); border: 1px solid rgba(79, 143, 255, 0.3); border-radius: 6px; color: var(--accent); font-size: 0.85rem; font-weight: 500; text-decoration: none;" data-i18n="Découvrir mon homelab">Découvrir mon homelab</a>
                    <a href="https://github.com/Tom1419-git/vektor" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 6px 12px; background: rgba(79, 143, 255, 0.1); border: 1px solid rgba(79, 143, 255, 0.3); border-radius: 6px; color: var(--accent); font-size: 0.85rem; font-weight: 500; text-decoration: none;" data-i18n="Vektor sur GitHub">Vektor sur GitHub</a>
                </div>

                <div class="info-box" style="background: rgba(79, 143, 255, 0.08); border: 1px solid rgba(79, 143, 255, 0.2); padding: 20px; border-radius: 8px;">
                    <strong style="color: var(--accent); display: inline-flex; align-items: center; gap: 8px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg><span data-i18n="Pour les curieux et les terminaux-addicts :">Pour les curieux et les terminaux-addicts :</span></strong><br>
                    <span style="color: var(--text-muted); font-size: 0.9rem;" data-i18n="Essayez cette commande dans votre terminal :">Essayez cette commande dans votre terminal :</span> <br>
                    <code style="display: block; margin-top: 10px; background: #000; padding: 10px; border-radius: 4px; color: var(--text-main); border: 1px solid var(--glass-border); font-family: monospace;">curl https://mayoraz-net.ch/api/cv.json</code>
                </div>
            </section>

            <section class="wm-features" style="padding: 0; max-width: 800px; margin: 0 auto 60px;">
                <p class="wm-section-eyebrow" data-i18n="// EXPERTISE">// EXPERTISE</p>
                <h2 class="wm-section-title" data-i18n="Mes Compétences">Mes <span class="accent">Compétences</span></h2>
                
                <div class="wm-features-grid" style="grid-template-columns: 1fr; gap: 4px; margin-top: 40px;">
                    <div class="wm-feature-card" style="padding: 24px 30px; display: flex; align-items: center; justify-content: space-between;">
                        <h3 style="margin: 0; font-size: 1rem; display: flex; align-items: center; gap: 10px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg><span data-i18n="Administration Réseau & Serveurs">Administration Réseau & Serveurs</span></h3>
                        <span style="color: var(--accent); font-weight: 900; font-size: 1.2rem;">90%</span>
                    </div>
                    <div class="wm-feature-card" style="padding: 24px 30px; display: flex; align-items: center; justify-content: space-between;">
                        <h3 style="margin: 0; font-size: 1rem; display: flex; align-items: center; gap: 10px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg><span data-i18n="Hardware, Montage PC & Dépannage">Hardware, Montage PC & Dépannage</span></h3>
                        <span style="color: var(--accent); font-weight: 900; font-size: 1.2rem;">95%</span>
                    </div>
                    <div class="wm-feature-card" style="padding: 24px 30px; display: flex; align-items: center; justify-content: space-between;">
                        <h3 style="margin: 0; font-size: 1rem; display: flex; align-items: center; gap: 10px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span data-i18n="Systèmes, Sécurité &amp; Haute Disponibilité">Systèmes, Sécurité &amp; Haute Disponibilité</span></h3>
                        <span style="color: var(--accent); font-weight: 900; font-size: 1.2rem;">85%</span>
                    </div>
                    <div class="wm-feature-card" style="padding: 24px 30px; display: flex; align-items: center; justify-content: space-between;">
                        <h3 style="margin: 0; font-size: 1rem; display: flex; align-items: center; gap: 10px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg><span data-i18n="Développement &amp; Automatisation (Python, CI/CD)">Développement &amp; Automatisation (Python, CI/CD)</span></h3>
                        <span style="color: var(--accent); font-weight: 900; font-size: 1.2rem;">75%</span>
                    </div>
                </div>
            </section>

            <section class="wm-bento" style="padding: 0; max-width: 800px; margin: 0 auto 60px;">
                <div class="wm-bento-grid" style="grid-template-columns: 1fr; margin-top: 0;">
                    <a href="/contact/" class="wm-bento-cell col-12" style="background:rgba(79,143,255,0.08);border-color:rgba(79,143,255,0.2); text-align: center; padding: 40px; align-items: center;">
                        <div class="cell-title" style="font-size: 1.5rem; margin-bottom: 10px;" data-i18n="Prêt à collaborer ?">Prêt à collaborer ?</div>
                        <div class="cell-desc" style="margin-bottom: 24px; max-width: 600px; text-align: center;" data-i18n="Contactez-moi dès maintenant pour discuter de votre projet informatique, que ce soit un site web, un montage PC ou une assistance technique.">Contactez-moi dès maintenant pour discuter de votre projet informatique, que ce soit un site web, un montage PC ou une assistance technique.</div>
                        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
                            <span class="btn-accent" data-i18n="Me Contacter">Me Contacter</span>
                            <span class="btn-outline" data-i18n="Mon LinkedIn">Mon LinkedIn</span>
                        </div>
                    </a>
                </div>
            </section>

            <section class="wm-card" style="max-width: 800px; margin: 0 auto 60px; padding: 30px;">
                <p class="wm-section-eyebrow" style="text-align: left; margin-bottom: 10px;" data-i18n="// SECRETS">// SECRETS</p>
                <h3 style="margin-bottom: 16px; font-size: 1.1rem; color: var(--text-heading); display: flex; align-items: center; gap: 8px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/><circle cx="12" cy="12" r="10"/></svg><span data-i18n="Secrets & Easter Eggs">Secrets & Easter Eggs</span></h3>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;" data-i18n="Ce site cache quelques secrets pour les plus curieux :">Ce site cache quelques secrets pour les plus curieux :</p>
                <ul style="list-style-type: none; padding: 0; display: flex; flex-direction: column; gap: 10px;">
                    <li style="font-size: 0.85rem; color: var(--text-muted);"><strong style="color: var(--text-main);" data-i18n="Konami Code :">Konami Code :</strong> <span data-i18n="Haut, Haut, Bas, Bas, Gauche, Droite, Gauche, Droite, B, A">Haut, Haut, Bas, Bas, Gauche, Droite, Gauche, Droite, B, A</span></li>
                    <li style="font-size: 0.85rem; color: var(--text-muted);"><strong style="color: var(--text-main);" data-i18n="Terminal caché :">Terminal caché :</strong> <span data-i18n-html="Appuyez sur <code>Shift + F10</code> n'importe où sur le site">Appuyez sur <code>Shift + F10</code> n'importe où sur le site</span></li>
                    <li style="font-size: 0.85rem; color: var(--text-muted);"><strong style="color: var(--text-main);" data-i18n="API :">API :</strong> <code style="background: #000; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--glass-border);">curl https://mayoraz-net.ch/api/cv.json</code></li>
                </ul>
            </section>
        </main>
    </div>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>

    {

        "@context": "https://schema.org",

        "@type": "Person",

        "name": "Thomas Mayoraz",

        "jobTitle": "Apprenti Informatique",

        "url": "https://mayoraz-net.ch",

        "sameAs": ["https://github.com/Tom1419-git", "https://www.linkedin.com/in/thomas-mayoraz/"],

        "worksFor": {

            "@type": "Organization",

            "name": "ETML Lausanne"

        }

    }

    </script>
    <script is:inline>
      function updateDynamicText() {
        const ageSpan = document.getElementById('dynamic-age');
        const yearSpan = document.getElementById('dynamic-year');
        if (!ageSpan || !yearSpan) return;

        const birthDate = new Date('2009-01-14');
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }
        
        // Année scolaire : commence en août. 1ère = 2024-2025, 2ème = 2025-2026, 3ème = 2026-2027, 4ème = 2027-2028
        const startApprenticeship = new Date('2024-08-01');
        const schoolYearStart = today.getMonth() >= 7 ? today.getFullYear() : today.getFullYear() - 1;
        let year = schoolYearStart - startApprenticeship.getFullYear() + 1;
        if (year > 4) year = 4;
        if (year < 1) year = 1;

        const currentLang = localStorage.getItem('site_lang') || 'FR';

        ageSpan.textContent = age;
        
        if (currentLang === 'EN') {
            yearSpan.textContent = year === 1 ? '1st' : year === 2 ? '2nd' : year === 3 ? '3rd' : '4th';
        } else if (currentLang === 'DE') {
            yearSpan.textContent = year + '.';
        } else {
            yearSpan.textContent = year === 1 ? '1ère' : year + 'ème';
        }
      }

      document.addEventListener('astro:page-load', updateDynamicText);
      document.addEventListener('languageChanged', updateDynamicText);
    </script>
    </Fragment>
</Layout>
