---
import { Image } from 'astro:assets';
import setup1Img from '../../assets/img/builds-pc/pc-setup1.webp';
import setup2Img from '../../assets/img/builds-pc/pc-setup2.webp';
import setup3Img from '../../assets/img/builds-pc/pc-setup3.webp';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Builds PC - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Builds PC - Thomas Mayoraz | Services Informatiques Lausanne" description="Mes configurations PC personnalisées : gaming, workstation et home server. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">
                <div class="avatar">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" />
                    <div class="avatar-fallback">TM</div>
                </div>
                <h1 data-i18n="Mes Builds PC">Mes Builds PC</h1>
                <p class="subtitle" data-i18n="Configurations personnalisées et optimisées">Configurations personnalisées et optimisées</p>
                <a class="back-nav" href="/" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main>
            <section class="intro reveal">
                <p data-i18n="Découvrez mes configurations PC personnalisées, assemblées avec soin pour différents usages : gaming, workstation et home server. Chaque build est optimisé pour son usage spécifique.">Découvrez mes configurations PC personnalisées, assemblées avec soin pour différents usages : gaming, workstation et home server. Chaque build est optimisé pour son usage spécifique.</p>
            </section>
            
            
            <div class="builds-grid">
                <div class="build-card">
                                        <div class="build-image carousel-container">
                        <div class="carousel-slide active">
                            <Image src={setup1Img} alt="Mon Setup Actuel - Vue 1" data-i18n="Mon Setup Actuel - Vue 1" onclick="openModal(this.src)" />
                        </div>
                        <div class="carousel-slide">
                            <Image src={setup2Img} alt="Mon Setup Actuel - Vue 2" data-i18n="Mon Setup Actuel - Vue 2" onclick="openModal(this.src)" />
                        </div>
                        <div class="carousel-slide">
                            <Image src={setup3Img} alt="Mon Setup Actuel - Vue 3" data-i18n="Mon Setup Actuel - Vue 3" onclick="openModal(this.src)" />
                        </div>
                        <button class="carousel-btn prev-btn" aria-label="Image précédente" data-i18n-aria="Image précédente">❮</button>
                        <button class="carousel-btn next-btn" aria-label="Image suivante" data-i18n-aria="Image suivante">❯</button>
                        <div class="carousel-dots">
                            <span class="dot active" data-slide="0"></span>
                            <span class="dot" data-slide="1"></span>
                            <span class="dot" data-slide="2"></span>
                        </div>
                    </div>
                    <div class="build-content">
                        <div class="build-header">
                            <h3 class="build-title" data-i18n="Mon Setup Actuel">Mon Setup Actuel</h3>
                            <p class="build-subtitle" data-i18n="Configuration personnelle">Configuration personnelle</p>
                            <span class="build-status" data-i18n="ACTIF">ACTIF</span>
                        </div>
                        <p class="build-description" data-i18n="Ma machine principale quotidienne, optimisée pour le développement, la productivité et le gaming fluide. Équipée des dernières technologies AMD pour des performances optimales sans compromis.">
                            Ma machine principale quotidienne, optimisée pour le développement, la productivité et le gaming fluide. Équipée des dernières technologies AMD pour des performances optimales sans compromis.
                        </p>
                        <ul class="build-specs">
                            <li><span class="spec-label" data-i18n="Boîtier">Boîtier</span> Hyte Y60</li>
                            <li><span class="spec-label" data-i18n="Processeur">Processeur</span> AMD Ryzen 7 7700X</li>
                            <li><span class="spec-label" data-i18n="Carte Mère">Carte Mère</span> Gigabyte B650E AORUS Elite X AX ICE</li>
                            <li><span class="spec-label" data-i18n="Carte Graphique">Carte Graphique</span> AMD Radeon RX 6750 XT</li>
                            <li><span class="spec-label" data-i18n="Mémoire Vive">Mémoire Vive</span> Kingston 32GB DDR5 6000MT/s CL30</li>
                            <li><span class="spec-label" data-i18n="Refroidissement">Refroidissement</span> Lian-Li GALAHAD II 360 Trinity Perf.</li>
                            <li><span class="spec-label" data-i18n="Ventilation">Ventilation</span> 6x Lian-Li UNI FAN SL-INF 120 ARGB</li>
                            <li><span class="spec-label" data-i18n="Alimentation">Alimentation</span> Enermax Revo. DF2 850W 80+ Gold</li>
                            <li><span class="spec-label" data-i18n="Stockage">Stockage</span> 1 To NVMe SSD + 128 Go SSD</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Modal Gallery -->
            <div id="imageModal" class="modal-gallery">
                <button id="modalClose" class="modal-close" aria-label="Fermer la galerie">&times;</button>
                <button id="modalPrev" class="modal-nav prev">❮</button>
                <img id="modalImage" class="modal-content" src="" alt="Aperçu agrandi">
                <button id="modalNext" class="modal-nav next">❯</button>
            </div>

        </main>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Builds PC",
        "description": "Collection de configurations PC assemblées par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/builds-pc/",
        "numberOfItems": 1,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "Thing",
                    "name": "PC Gaming",
                    "description": "Configuration haut de gamme pour le gaming"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "Thing",
                    "name": "Workstation",
                    "description": "Station de travail pour développement et création"
                }
            }
        ]
    }
    </script>
<script is:inline>
        document.addEventListener('astro:page-load', () => {
            const slides = document.querySelectorAll('.carousel-slide');
            const dots = document.querySelectorAll('.dot');
            const prevBtn = document.querySelector('.prev-btn');
            const nextBtn = document.querySelector('.next-btn');
            let currentSlide = 0;
            let slideInterval;

            function showSlide(index) {
                slides.forEach(slide => slide.classList.remove('active'));
                dots.forEach(dot => dot.classList.remove('active'));
                if (index >= slides.length) currentSlide = 0;
                else if (index < 0) currentSlide = slides.length - 1;
                else currentSlide = index;
                slides[currentSlide].classList.add('active');
                dots[currentSlide].classList.add('active');
            }
            function nextSlide() { showSlide(currentSlide + 1); }
            function prevSlide() { showSlide(currentSlide - 1); }
            function startSlideShow() { slideInterval = setInterval(nextSlide, 3500); }
            function resetInterval() { clearInterval(slideInterval); startSlideShow(); }

            nextBtn.addEventListener('click', () => { nextSlide(); resetInterval(); });
            prevBtn.addEventListener('click', () => { prevSlide(); resetInterval(); });
            dots.forEach((dot, index) => { dot.addEventListener('click', () => { showSlide(index); resetInterval(); }); });

            const container = document.querySelector('.carousel-container');
            if (container) {
                container.addEventListener('mouseenter', () => clearInterval(slideInterval));
                container.addEventListener('mouseleave', startSlideShow);
            }

            // Modal Gallery Logic
            const modal = document.getElementById("imageModal");
            const modalImg = document.getElementById("modalImage");
            const closeBtn = document.getElementById("modalClose");
            const mPrevBtn = document.getElementById("modalPrev");
            const mNextBtn = document.getElementById("modalNext");
            const images = Array.from(document.querySelectorAll(".carousel-slide img")).map(img => img.src);
            let currentModalIndex = 0;

            window.openModal = function(src) {
                if (modal && modalImg) {
                    currentModalIndex = images.indexOf(src);
                    if(currentModalIndex === -1) currentModalIndex = 0;
                    modal.style.display = 'flex';
                    modal.classList.add("show");
                    modalImg.src = images[currentModalIndex];
                }
            };

            function changeModalImage(step) {
                currentModalIndex += step;
                if(currentModalIndex >= images.length) currentModalIndex = 0;
                if(currentModalIndex < 0) currentModalIndex = images.length - 1;
                modalImg.src = images[currentModalIndex];
            }

            if (modal && closeBtn) {
                closeBtn.addEventListener('click', () => { modal.classList.remove("show"); setTimeout(() => { modal.style.display = ''; }, 300); });
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) { modal.classList.remove("show"); setTimeout(() => { modal.style.display = ''; }, 300); }
                });
                mPrevBtn.addEventListener('click', (e) => { e.stopPropagation(); changeModalImage(-1); });
                mNextBtn.addEventListener('click', (e) => { e.stopPropagation(); changeModalImage(1); });
                
                document.addEventListener('keydown', (e) => {
                    if(modal.classList.contains('show')) {
                        if(e.key === 'ArrowRight') changeModalImage(1);
                        if(e.key === 'ArrowLeft') changeModalImage(-1);
                        if(e.key === 'Escape') closeBtn.click();
                    }
                });
            }

            startSlideShow();
        });
    </script>
    </Fragment>
</Layout>
