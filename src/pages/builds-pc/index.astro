---
import { Image } from 'astro:assets';
import setup1Img from '../../assets/img/builds-pc/pc-setup1.webp';
import setup2Img from '../../assets/img/builds-pc/pc-setup2.webp';
import setup3Img from '../../assets/img/builds-pc/pc-setup3.webp';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Builds PC - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Builds PC - Thomas Mayoraz | Services Informatiques Lausanne" description="Mes configurations PC personnalisées : gaming, workstation et home server. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">
                <div class="avatar" style="width: 100px; height: 100px; margin: 0 auto 20px; border-radius: 50%; overflow: hidden; border: 2px solid var(--glass-border);">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <p class="wm-section-eyebrow" data-i18n="Mes Builds PC">Mes Builds PC</p>
                <h1 class="wm-section-title" data-i18n-html="Configurations personnalisées et <span class='accent'>optimisées</span>">Configurations personnalisées et <span class="accent">optimisées</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px;" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main style="max-width: 1200px; margin: 0 auto 60px;">
            <section class="wm-card" style="padding: 30px; margin-bottom: 40px; text-align: center;">
                <p style="color: var(--text-heading); line-height: 1.7; font-size: 1.1rem; margin-bottom: 0;" data-i18n="Découvrez mes configurations PC personnalisées, assemblées avec soin pour différents usages : gaming, workstation et home server. Chaque build est optimisé pour son usage spécifique.">Découvrez mes configurations PC personnalisées, assemblées avec soin pour différents usages : gaming, workstation et home server. Chaque build est optimisé pour son usage spécifique.</p>
            </section>
            
            <div style="display: grid; grid-template-columns: 1fr; gap: 40px;">
                <div class="wm-card" style="display: grid; grid-template-columns: 1fr; gap: 0; padding: 0; overflow: hidden;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0;">
                        <div class="build-image carousel-container" style="position: relative; width: 100%; height: 100%; min-height: 400px; background: #000;">
                            <div class="carousel-slide active" style="position: absolute; inset: 0; opacity: 1; transition: opacity 0.5s;">
                                <Image src={setup1Img} alt="Mon Setup Actuel - Vue 1" data-i18n="Mon Setup Actuel - Vue 1" onclick="openModal(this.src)" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;" />
                            </div>
                            <div class="carousel-slide" style="position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s;">
                                <Image src={setup2Img} alt="Mon Setup Actuel - Vue 2" data-i18n="Mon Setup Actuel - Vue 2" onclick="openModal(this.src)" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;" />
                            </div>
                            <div class="carousel-slide" style="position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s;">
                                <Image src={setup3Img} alt="Mon Setup Actuel - Vue 3" data-i18n="Mon Setup Actuel - Vue 3" onclick="openModal(this.src)" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;" />
                            </div>
                            <button class="carousel-btn prev-btn" aria-label="Image précédente" data-i18n-aria="Image précédente" style="position: absolute; top: 50%; left: 10px; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; padding: 10px; cursor: pointer; border-radius: 4px;">❮</button>
                            <button class="carousel-btn next-btn" aria-label="Image suivante" data-i18n-aria="Image suivante" style="position: absolute; top: 50%; right: 10px; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; padding: 10px; cursor: pointer; border-radius: 4px;">❯</button>
                            <div class="carousel-dots" style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px;">
                                <span class="dot active" data-slide="0" style="width: 10px; height: 10px; border-radius: 50%; background: white; cursor: pointer; opacity: 1;"></span>
                                <span class="dot" data-slide="1" style="width: 10px; height: 10px; border-radius: 50%; background: white; cursor: pointer; opacity: 0.5;"></span>
                                <span class="dot" data-slide="2" style="width: 10px; height: 10px; border-radius: 50%; background: white; cursor: pointer; opacity: 0.5;"></span>
                            </div>
                        </div>
                        <div style="padding: 40px; display: flex; flex-direction: column; justify-content: center;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                                <div>
                                    <h3 style="color: var(--text-heading); font-size: 1.8rem; margin: 0 0 8px 0;" data-i18n="Mon Setup Actuel">Mon Setup Actuel</h3>
                                    <p style="color: var(--text-muted); font-size: 1rem; margin: 0;" data-i18n="Configuration personnelle">Configuration personnelle</p>
                                </div>
                                <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;" data-i18n="ACTIF">ACTIF</span>
                            </div>
                            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.7; margin-bottom: 30px;" data-i18n="Ma machine principale quotidienne, optimisée pour le développement, la productivité et le gaming fluide. Équipée des dernières technologies AMD pour des performances optimales sans compromis.">
                                Ma machine principale quotidienne, optimisée pour le développement, la productivité et le gaming fluide. Équipée des dernières technologies AMD pour des performances optimales sans compromis.
                            </p>
                            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Boîtier">Boîtier</span> <span style="color: var(--text-main); text-align: right;">Hyte Y60</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Processeur">Processeur</span> <span style="color: var(--text-main); text-align: right;">AMD Ryzen 7 7700X</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Carte Mère">Carte Mère</span> <span style="color: var(--text-main); text-align: right;">Gigabyte B650E AORUS Elite X AX ICE</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Carte Graphique">Carte Graphique</span> <span style="color: var(--text-main); text-align: right;">AMD Radeon RX 6750 XT</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Mémoire Vive">Mémoire Vive</span> <span style="color: var(--text-main); text-align: right;">Kingston 32GB DDR5 6000MT/s CL30</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Refroidissement">Refroidissement</span> <span style="color: var(--text-main); text-align: right;">Lian-Li GALAHAD II 360 Trinity Perf.</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Ventilation">Ventilation</span> <span style="color: var(--text-main); text-align: right;">6x Lian-Li UNI FAN SL-INF 120 ARGB</span></li>
                                <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--glass-border); padding-bottom: 8px;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Alimentation">Alimentation</span> <span style="color: var(--text-main); text-align: right;">Enermax Revo. DF2 850W 80+ Gold</span></li>
                                <li style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted); font-weight: 600;" data-i18n="Stockage">Stockage</span> <span style="color: var(--text-main); text-align: right;">1 To NVMe SSD + 128 Go SSD</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Gallery -->
            <div id="imageModal" class="modal-gallery">
                <button id="modalClose" class="modal-close" aria-label="Fermer la galerie">&times;</button>
                <button id="modalPrev" class="modal-nav prev">❮</button>
                <img id="modalImage" class="modal-content" src="" alt="Aperçu agrandi">
                <button id="modalNext" class="modal-nav next">❯</button>
            </div>

        </main>
    </div>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Builds PC",
        "description": "Collection de configurations PC assemblées par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/builds-pc/",
        "numberOfItems": 1,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "Thing",
                    "name": "PC Gaming",
                    "description": "Configuration haut de gamme pour le gaming"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "Thing",
                    "name": "Workstation",
                    "description": "Station de travail pour développement et création"
                }
            }
        ]
    }
    </script>
<script is:inline>
        document.addEventListener('astro:page-load', () => {
            const slides = document.querySelectorAll('.carousel-slide');
            const dots = document.querySelectorAll('.dot');
            const prevBtn = document.querySelector('.prev-btn');
            const nextBtn = document.querySelector('.next-btn');
            let currentSlide = 0;
            let slideInterval;

            function showSlide(index) {
                slides.forEach(slide => slide.classList.remove('active'));
                dots.forEach(dot => dot.classList.remove('active'));
                if (index >= slides.length) currentSlide = 0;
                else if (index < 0) currentSlide = slides.length - 1;
                else currentSlide = index;
                slides[currentSlide].classList.add('active');
                dots[currentSlide].classList.add('active');
            }
            function nextSlide() { showSlide(currentSlide + 1); }
            function prevSlide() { showSlide(currentSlide - 1); }
            function startSlideShow() { slideInterval = setInterval(nextSlide, 3500); }
            function resetInterval() { clearInterval(slideInterval); startSlideShow(); }

            nextBtn.addEventListener('click', () => { nextSlide(); resetInterval(); });
            prevBtn.addEventListener('click', () => { prevSlide(); resetInterval(); });
            dots.forEach((dot, index) => { dot.addEventListener('click', () => { showSlide(index); resetInterval(); }); });

            const container = document.querySelector('.carousel-container');
            if (container) {
                container.addEventListener('mouseenter', () => clearInterval(slideInterval));
                container.addEventListener('mouseleave', startSlideShow);
            }

            // Modal Gallery Logic
            const modal = document.getElementById("imageModal");
            const modalImg = document.getElementById("modalImage");
            const closeBtn = document.getElementById("modalClose");
            const mPrevBtn = document.getElementById("modalPrev");
            const mNextBtn = document.getElementById("modalNext");
            const images = Array.from(document.querySelectorAll(".carousel-slide img")).map(img => img.src);
            let currentModalIndex = 0;

            window.openModal = function(src) {
                if (modal && modalImg) {
                    currentModalIndex = images.indexOf(src);
                    if(currentModalIndex === -1) currentModalIndex = 0;
                    modal.style.display = 'flex';
                    modal.classList.add("show");
                    modalImg.src = images[currentModalIndex];
                }
            };

            function changeModalImage(step) {
                currentModalIndex += step;
                if(currentModalIndex >= images.length) currentModalIndex = 0;
                if(currentModalIndex < 0) currentModalIndex = images.length - 1;
                modalImg.src = images[currentModalIndex];
            }

            if (modal && closeBtn) {
                closeBtn.addEventListener('click', () => { modal.classList.remove("show"); setTimeout(() => { modal.style.display = ''; }, 300); });
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) { modal.classList.remove("show"); setTimeout(() => { modal.style.display = ''; }, 300); }
                });
                mPrevBtn.addEventListener('click', (e) => { e.stopPropagation(); changeModalImage(-1); });
                mNextBtn.addEventListener('click', (e) => { e.stopPropagation(); changeModalImage(1); });
                
                document.addEventListener('keydown', (e) => {
                    if(modal.classList.contains('show')) {
                        if(e.key === 'ArrowRight') changeModalImage(1);
                        if(e.key === 'ArrowLeft') changeModalImage(-1);
                        if(e.key === 'Escape') closeBtn.click();
                    }
                });
            }

            startSlideShow();
        });
    </script>
    </Fragment>
</Layout>
