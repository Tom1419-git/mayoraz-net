---
const buildHash = Date.now().toString(36);
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';
---

<Layout title="Thomas Mayoraz - Quiz Tech | Testez vos connaissances informatiques" description="Quiz interactif sur l'informatique avec Thomas Mayoraz. Testez vos connaissances en programmation, sécurité, hardware et technologies web. 15 questions techniques pour évaluer votre niveau." cssFile="/media/css/jeu.css">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">                <h1 data-i18n="Quiz Tech">Quiz Tech</h1>
                <p class="subtitle" data-i18n="Testez vos connaissances informatiques">Testez vos connaissances informatiques</p>
                <a class="back-nav" href="/" data-i18n="← Retour à l'accueil">← Retour à l'accueil</a>
                <a class="back-nav" href="/jeu-trex/" style="margin-left: 10px;" data-i18n="🎮 Vous préférez jouer ? Essayez Admin Run">🎮 Vous préférez jouer ? Essayez Admin Run</a>
            </div>
        </header>

        <div id="intro-container" class="intro-box">
    <h2 data-i18n="Prêt pour le défi ?">Prêt pour le défi ?</h2>
    <p data-i18n="15 questions techniques tirées au hasard. Un classement remis à zéro chaque minuit.">15 questions techniques tirées au hasard. Un classement remis à zéro chaque minuit.</p>
    <input type="text" id="pseudo-input" class="pseudo-input" placeholder="Entrez votre pseudo..." data-i18n-placeholder="Entrez votre pseudo..." maxlength="15" aria-label="Ton pseudo">
    <br>
    <button id="start-quiz-btn" class="btn-primary" style="width: 80%; display: inline-block;" data-i18n="Commencer le Quiz">Commencer le Quiz</button>
</div>

<div id="quiz-container" style="display: none;">
    <h2 data-i18n="Quiz Tech : Testez Vos Connaissances Informatiques">Quiz Tech : Testez Vos Connaissances Informatiques</h2>
    <div id="progress">Question 1/15</div>
    <div class="question" id="question-text" data-i18n="Chargement des questions...">Chargement des questions...</div>
    <div class="options-container" id="options-container"></div>
    <div id="feedback"></div>
    <button id="next-btn" data-i18n="Suivant">Suivant</button>
    
    <div id="results">
        <div id="score"></div>
        <div id="rank"></div>
        <div id="comment"></div>
        <button id="show-answers-btn" data-i18n="Afficher les réponses">Afficher les réponses</button>
        <button id="restart-btn" data-i18n="Recommencer le quiz">Recommencer le quiz</button>
    </div>

    
    <div id="leaderboard-container" class="leaderboard-box" style="display: none;">
        <h2 data-i18n="🏆 Classement du Jour">🏆 Classement du Jour</h2>
        <table class="leaderboard-table">
            <thead>
                <tr>
                    <th data-i18n="Rang">Rang</th>
                    <th data-i18n="Pseudo">Pseudo</th>
                    <th data-i18n="Score">Score</th>
                </tr>
            </thead>
            <tbody id="leaderboard-body">
            </tbody>
        </table>
        <p class="leaderboard-footer" data-i18n="Le classement se réinitialise tous les jours à minuit.">Le classement se réinitialise tous les jours à minuit.</p>
    </div>

    <div id="all-answers"></div>
</div>

    <ContactCta title="Un projet ou un défi tech ?" text="Après le quiz, passez à la pratique : je développe des sites web, des applications et des infrastructures homelab. Discutons du vôtre." />
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "Quiz",
        "name": "Quiz Tech - Connaissances Informatiques",
        "description": "Questionnaire interactif testant les connaissances en informatique, programmation et technologies web",
        "url": "https://mayoraz-net.ch/jeu/",
        "author": {
            "@type": "Person",
            "name": "Thomas Mayoraz",
            "jobTitle": "Apprenti Informatique",
            "worksFor": {
                "@type": "Organization",
                "name": "ETML Lausanne"
            }
        },
        "educationalLevel": "Intermediate",
        "hasPart": {
            "@type": "Question",
            "name": "Question sur les technologies informatiques",
            "question": "Qu'est-ce qu'une variable en programmation ?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un conteneur pour stocker des données"
            }
        },
        "datePublished": "2025-01-01",
        "timeRequired": "PT10M"
    }
    </script>

<script is:inline src={`/media/js/quiz.js?v=${buildHash}`} defer></script>
    </Fragment>
</Layout>
