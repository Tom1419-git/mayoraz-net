---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Contact - Thomas Mayoraz | Services Informatiques Lausanne" description="Contactez-moi pour vos projets informatiques à Lausanne : développement web, montage PC, dépannage. Thomas Mayoraz, expert en services informatiques." cssFile="/media/css/contact.css">
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">
                <div class="avatar" style="width: 100px; height: 100px; margin: 0 auto 20px; border-radius: 50%; overflow: hidden; border: 2px solid var(--glass-border);">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <p class="wm-section-eyebrow" data-i18n="Me Contacter">Me Contacter</p>
                <h1 class="wm-section-title" data-i18n="Discutons de votre projet">Discutons de votre <span class="accent">projet</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px; margin-bottom: 20px;" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
                <div>
                    <a href="/media/thomas_mayoraz.vcf" class="btn-accent" style="display: inline-flex; align-items: center;" download="">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span data-i18n="Télécharger ma VCard">Télécharger ma VCard</span>
                    </a>
                </div>
            </div>
        </header>

        <main style="max-width: 900px; margin: 0 auto 60px;">
            <section class="wm-card" style="padding: 40px; margin-bottom: 40px;">
                <h2 style="font-size: 1.5rem; color: var(--text-heading); margin-bottom: 16px;" data-i18n="Parlons de votre projet">Parlons de votre projet</h2>
                <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 30px;" data-i18n="Que ce soit pour un site web, un montage PC ou un dépannage informatique, je suis là pour vous accompagner. Remplissez le formulaire ci-dessous et je vous répondrai dans les plus brefs délais.">Que ce soit pour un site web, un montage PC ou un dépannage informatique, je suis là pour vous accompagner. Remplissez le formulaire ci-dessous et je vous répondrai dans les plus brefs délais.</p>

                <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
                    <input type="hidden" name="access_key" value="eb846c13-ea8a-428d-be1f-9db1c7cf55e5">
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                            <label for="prenom" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n-html="form_prenom">Prénom <span style="color: var(--accent);">*</span></label>
                            <input type="text" id="prenom" name="prenom" required="" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif;">
                        </div>
                        <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                            <label for="nom" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n-html="form_nom">Nom <span style="color: var(--accent);">*</span></label>
                            <input type="text" id="nom" name="nom" required="" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif;">
                        </div>
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                        <label for="email" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n-html="form_email">Email <span style="color: var(--accent);">*</span></label>
                        <input type="email" id="email" name="email" required="" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif;">
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                        <label for="telephone" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n="Téléphone">Téléphone</label>
                        <input type="tel" id="telephone" name="telephone" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif;">
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                        <label for="service" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n-html="form_service">Type de prestation <span style="color: var(--accent);">*</span></label>
                        <select id="service" name="service" required="" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif; appearance: none;">
                            <option value="" style="background: var(--bg-dark);" data-i18n="Sélectionnez un service">Sélectionnez un service</option>
                            <option value="site-web-personnel" style="background: var(--bg-dark);" data-i18n="Site web personnel">Site web personnel</option>
                            <option value="site-web-entreprise" style="background: var(--bg-dark);" data-i18n="Site web d'entreprise">Site web d'entreprise</option>
                            <option value="montage-pc" style="background: var(--bg-dark);" data-i18n="Configuration PC sur mesure">Configuration PC sur mesure</option>
                            <option value="depannage" style="background: var(--bg-dark);" data-i18n="Dépannage informatique">Dépannage informatique</option>
                            <option value="conseil-technique" style="background: var(--bg-dark);" data-i18n="Conseil technique">Conseil technique</option>
                            <option value="autre" style="background: var(--bg-dark);" data-i18n="Autre (précisez dans le message)">Autre (précisez dans le message)</option>
                        </select>
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                        <label for="budget" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n="Budget approximatif (CHF)">Budget approximatif (CHF)</label>
                        <select id="budget" name="budget" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif; appearance: none;">
                            <option value="" style="background: var(--bg-dark);" data-i18n="Non défini">Non défini</option>
                            <option value="0-500" style="background: var(--bg-dark);" data-i18n="0 - 500 CHF">0 - 500 CHF</option>
                            <option value="500-1000" style="background: var(--bg-dark);" data-i18n="500 - 1000 CHF">500 - 1000 CHF</option>
                            <option value="1000-2000" style="background: var(--bg-dark);" data-i18n="1000 - 2000 CHF">1000 - 2000 CHF</option>
                            <option value="2000-5000" style="background: var(--bg-dark);" data-i18n="2000 - 5000 CHF">2000 - 5000 CHF</option>
                            <option value="5000+" style="background: var(--bg-dark);" data-i18n="Plus de 5000 CHF">Plus de 5000 CHF</option>
                        </select>
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 8px;">
                        <label for="message" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);" data-i18n-html="form_message">Message détaillé <span style="color: var(--accent);">*</span></label>
                        <textarea id="message" name="message" placeholder="Décrivez votre projet, vos besoins, vos attentes..." style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 12px 16px; border-radius: 6px; color: var(--text-main); font-family: 'Inter', sans-serif; min-height: 150px; resize: vertical;" data-i18n="Décrivez votre projet, vos besoins, vos attentes..." required=""></textarea>
                    </div>

                    <div id="cf-turnstile-container" style="margin: 20px 0; display: flex; justify-content: center;"></div>
                    
                    <button type="submit" class="btn-accent" style="width: 100%; justify-content: center; padding: 14px; font-size: 1rem;">
                        <span data-i18n="Envoyer le message">Envoyer le message</span>
                    </button>
                </form>
            </section>

            <section class="wm-bento">
                <p class="wm-section-eyebrow" style="text-align: left;" data-i18n="// SERVICES">// SERVICES</p>
                <h3 style="font-size: 1.5rem; color: var(--text-heading); margin-bottom: 20px;" data-i18n="🛠️ Mes services en détail">🛠️ Mes services en détail</h3>
                <div class="wm-bento-grid" style="grid-template-columns: repeat(2, 1fr); margin-top: 0;">
                    <div class="wm-bento-cell" style="grid-column: span 1;">
                        <h4 style="color: var(--text-heading); font-size: 1.1rem; margin-bottom: 8px;" data-i18n="Sites Web">Sites Web</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;" data-i18n="Création de sites personnels, portfolios, sites vitrines pour entreprises. Design moderne et responsive.">Création de sites personnels, portfolios, sites vitrines pour entreprises. Design moderne et responsive.</p>
                    </div>
                    <div class="wm-bento-cell" style="grid-column: span 1;">
                        <h4 style="color: var(--text-heading); font-size: 1.1rem; margin-bottom: 8px;" data-i18n="Montage PC">Montage PC</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;" data-i18n="Configuration sur mesure selon vos besoins : gaming, bureautique, workstation. Conseil et assemblage.">Configuration sur mesure selon vos besoins : gaming, bureautique, workstation. Conseil et assemblage.</p>
                    </div>
                    <div class="wm-bento-cell" style="grid-column: span 1;">
                        <h4 style="color: var(--text-heading); font-size: 1.1rem; margin-bottom: 8px;" data-i18n="Dépannage">Dépannage</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;" data-i18n="Résolution de problèmes informatiques, installation de logiciels, optimisation des performances.">Résolution de problèmes informatiques, installation de logiciels, optimisation des performances.</p>
                    </div>
                    <div class="wm-bento-cell" style="grid-column: span 1;">
                        <h4 style="color: var(--text-heading); font-size: 1.1rem; margin-bottom: 8px;" data-i18n="Conseil Technique">Conseil Technique</h4>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;" data-i18n="Accompagnement dans vos choix technologiques, recommandations matériel et logiciel.">Accompagnement dans vos choix technologiques, recommandations matériel et logiciel.</p>
                    </div>
                </div>
            </section>
        </main>
    </div>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Contact Thomas Mayoraz",
        "description": "Page de contact pour les services informatiques à Lausanne",
        "url": "https://mayoraz-net.ch/contact/",
        "potentialAction": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "telephone": "+41-076-612-2053",
            "email": "contact@mayoraz-net.ch",
            "areaServed": "Lausanne et région"
        }
    }
    </script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&amp;onload=onloadTurnstileCallback" async="" defer=""></script>
<script is:inline>


        // Système de captcha avancé
        document.addEventListener('astro:page-load', () => {
            const contactForm = document.querySelector('.contact-form');
            if (!contactForm) return;
            contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const turnstileResponse = document.querySelector('[name="cf-turnstile-response"]').value;
            if (!turnstileResponse) {
                alert(window.t ? window.t('Veuillez valider le captcha avant d\'envoyer.') : 'Veuillez valider le captcha avant d\'envoyer.');
                return false;
            }

            const form = this;
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.textContent;
            submitBtn.textContent = window.t ? window.t('Envoi en cours...') : 'Envoi en cours...';
            submitBtn.disabled = true;

            const formData = new FormData(form);
            formData.delete('cf-turnstile-response'); // Web3Forms Free ne supporte pas Turnstile côté serveur
            
            const object = Object.fromEntries(formData);
            const json = JSON.stringify(object);

            fetch(form.action, {
                method: form.method,
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: json
            }).then(response => {
                if (response.ok) {
                    window.location.href = '/contact/merci/';
                } else {
                    alert(window.t ? window.t('Erreur lors de l\'envoi. Veuillez réessayer.') : 'Erreur lors de l\'envoi. Veuillez réessayer.');
                    submitBtn.textContent = originalBtnText;
                    submitBtn.disabled = false;
                }
            }).catch(error => {
                alert(window.t ? window.t('Erreur de réseau. Vérifiez votre connexion.') : 'Erreur de réseau. Vérifiez votre connexion.');
                submitBtn.textContent = originalBtnText;
                submitBtn.disabled = false;
            });
            });
        });

        // Animation des inputs au focus
        const inputs = document.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.style.transform = 'scale(1.02)';
                this.parentElement.style.transition = 'transform 0.2s ease';
            });
            input.addEventListener('blur', function() {
                this.parentElement.style.transform = 'scale(1)';
            });
        });




    </script>
<script is:inline>
        let turnstileWidgetId = null;

        window.onloadTurnstileCallback = function () {
            renderTurnstile();
        };

        function renderTurnstile() {
            if (typeof turnstile === 'undefined') return;
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            
            if (turnstileWidgetId !== null) {
                turnstile.remove(turnstileWidgetId);
            }
            
            turnstileWidgetId = turnstile.render('#cf-turnstile-container', {
                sitekey: '0x4AAAAAADhc2UTooOzxGXSX',
                theme: currentTheme
            });
        }

        // Observer pour détecter quand le bouton thème est cliqué
        let observer;
        
        document.addEventListener('astro:page-load', () => {
            if (document.getElementById('cf-turnstile-container')) {
                // If script is already loaded
                if (typeof turnstile !== 'undefined') {
                    renderTurnstile();
                }
                
                if (!observer) {
                    observer = new MutationObserver((mutations) => {
                        mutations.forEach((mutation) => {
                            if (mutation.attributeName === 'data-theme') {
                                renderTurnstile();
                            }
                        });
                    });
                    observer.observe(document.documentElement, { attributes: true });
                }
            }
        });
    </script>
    </Fragment>
</Layout>
