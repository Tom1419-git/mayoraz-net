---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Contact - Thomas Mayoraz | Services Informatiques Lausanne" description="Contactez-moi pour vos projets informatiques à Lausanne : développement web, montage PC, dépannage. Thomas Mayoraz, expert en services informatiques." cssFile="/media/css/contact.css">
    <div class="wm-container" style="padding-top: 60px;">
        <header class="contact-header">
            <p class="wm-section-eyebrow" data-i18n="// CONTACT">// CONTACT</p>
            <h1 class="wm-section-title" data-i18n-html="Discutons de votre <span class='accent'>projet</span>">Discutons de votre <span class="accent">projet</span></h1>
            <p class="contact-intro" data-i18n="Que ce soit pour un site web, un montage PC ou un dépannage, je vous réponds rapidement.">Que ce soit pour un site web, un montage PC ou un dépannage, je vous réponds rapidement.</p>
            <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 8px;" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
        </header>

        <main class="contact-layout">

            <!-- Colonne gauche : formulaire -->
            <section class="wm-card contact-form-card">
                <div class="contact-form-header">
                    <h2 data-i18n="Envoyer un message">Envoyer un message</h2>
                    <a href="/media/thomas_mayoraz.vcf" class="btn-outline btn-vcard" download="">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span data-i18n="VCard">VCard</span>
                    </a>
                </div>

                <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
                    <input type="hidden" name="access_key" value="eb846c13-ea8a-428d-be1f-9db1c7cf55e5">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="prenom" data-i18n-html="form_prenom">Prénom <span class="required">*</span></label>
                            <input type="text" id="prenom" name="prenom" placeholder="Jean" required>
                        </div>
                        <div class="form-group">
                            <label for="nom" data-i18n-html="form_nom">Nom <span class="required">*</span></label>
                            <input type="text" id="nom" name="nom" placeholder="Dupont" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="email" data-i18n-html="form_email">Email <span class="required">*</span></label>
                            <input type="email" id="email" name="email" placeholder="jean.dupont@email.com" required>
                        </div>
                        <div class="form-group">
                            <label for="telephone" data-i18n="Téléphone">Téléphone</label>
                            <input type="tel" id="telephone" name="telephone" placeholder="+41 79 000 00 00">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="service" data-i18n-html="form_service">Service <span class="required">*</span></label>
                            <div class="select-wrapper">
                                <select id="service" name="service" required>
                                    <option value="" data-i18n="Sélectionnez...">Sélectionnez...</option>
                                    <option value="site-web-personnel" data-i18n="Site web personnel">Site web personnel</option>
                                    <option value="site-web-entreprise" data-i18n="Site web entreprise">Site web entreprise</option>
                                    <option value="montage-pc" data-i18n="Montage PC sur mesure">Montage PC sur mesure</option>
                                    <option value="depannage" data-i18n="Dépannage informatique">Dépannage informatique</option>
                                    <option value="conseil-technique" data-i18n="Conseil technique">Conseil technique</option>
                                    <option value="autre" data-i18n="Autre">Autre</option>
                                </select>
                                <svg class="select-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="commune" data-i18n="Commune / Ville">Commune / Ville</label>
                            <input type="text" id="commune" name="commune" placeholder="Lausanne, Morges, Renens...">
                        </div>
                    </div>

                    <!-- A : Urgence -->
                    <div class="form-group">
                        <label data-i18n="Délai souhaité">Délai souhaité</label>
                        <div class="chip-group" id="urgence-chips">
                            <input type="hidden" id="urgence" name="urgence" value="">
                            <button type="button" class="chip" data-value="pas-urgent" data-i18n="Pas urgent">Pas urgent</button>
                            <button type="button" class="chip" data-value="1-2-semaines" data-i18n="1–2 semaines">1–2 semaines</button>
                            <button type="button" class="chip" data-value="cette-semaine" data-i18n="Cette semaine">Cette semaine</button>
                            <button type="button" class="chip chip-urgent" data-value="urgent" data-i18n="URGENT 🔥">URGENT 🔥</button>
                        </div>
                    </div>

                    <!-- Budget -->
                    <div class="form-group">
                        <label data-i18n="Budget approximatif (CHF)">Budget approximatif (CHF)</label>
                        <div class="chip-group" id="budget-chips">
                            <input type="hidden" id="budget" name="budget" value="">
                            <button type="button" class="chip" data-value="" data-i18n="Non défini">Non défini</button>
                            <button type="button" class="chip" data-value="0-500">0–500</button>
                            <button type="button" class="chip" data-value="500-1000">500–1'000</button>
                            <button type="button" class="chip" data-value="1000-2000">1'000–2'000</button>
                            <button type="button" class="chip" data-value="2000+">2'000+</button>
                        </div>
                    </div>

                    <!-- E : Préférence de contact -->
                    <div class="form-group">
                        <label data-i18n="Préférence de contact">Préférence de contact</label>
                        <div class="radio-group">
                            <label class="radio-pill">
                                <input type="radio" name="contact_pref" value="Email" checked>
                                <span>
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                    Email
                                </span>
                            </label>
                            <label class="radio-pill">
                                <input type="radio" name="contact_pref" value="Téléphone">
                                <span>
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.63 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 1 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 1 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    Téléphone
                                </span>
                            </label>
                            <label class="radio-pill">
                                <input type="radio" name="contact_pref" value="WhatsApp">
                                <span>
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
                                    WhatsApp
                                </span>
                            </label>
                        </div>
                    </div>

                    <!-- Message -->
                    <div class="form-group">
                        <label for="message" data-i18n-html="form_message">Décris ton projet <span class="required">*</span></label>
                        <textarea id="message" name="message" placeholder="Dis-moi ce que tu veux faire, tes contraintes, tes délais... Plus c'est précis, mieux je peux t'aider !" required></textarea>
                        <span class="char-counter"><span id="char-count">0</span> / 1000</span>
                    </div>

                    <!-- D : Pièce jointe -->
                    <div class="form-group">
                        <label for="attachment" data-i18n="Pièce jointe (optionnel)">Pièce jointe <span class="label-optional" data-i18n="optionnel">optionnel</span></label>
                        <label class="file-upload-label" for="attachment">
                            <input type="file" id="attachment" name="attachment" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.zip" class="file-input">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            <span class="file-upload-text" data-i18n="Glisse un fichier ou clique pour choisir">Glisse un fichier ou clique pour choisir</span>
                            <span class="file-upload-hint">PDF, Word, image, ZIP — max 10 Mo</span>
                        </label>
                        <span class="file-name" id="file-name"></span>
                    </div>

                    <!-- C : Source -->
                    <div class="form-group">
                        <label for="source" data-i18n="Comment tu m'as trouvé ?">Comment tu m'as trouvé ?</label>
                        <div class="select-wrapper">
                            <select id="source" name="source">
                                <option value="" data-i18n="Je ne sais plus...">Je ne sais plus...</option>
                                <option value="google" data-i18n="Google">Google</option>
                                <option value="linkedin" data-i18n="LinkedIn">LinkedIn</option>
                                <option value="github" data-i18n="GitHub">GitHub</option>
                                <option value="bouche-a-oreille" data-i18n="Bouche à oreille">Bouche à oreille</option>
                                <option value="reseaux-sociaux" data-i18n="Réseaux sociaux">Réseaux sociaux</option>
                                <option value="etml" data-i18n="Via l'ETML">Via l'ETML</option>
                                <option value="autre" data-i18n="Autre">Autre</option>
                            </select>
                            <svg class="select-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                    </div>

                    <div id="cf-turnstile-container" class="turnstile-container"></div>

                    <button type="submit" class="btn-accent btn-submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                        <span data-i18n="Envoyer le message">Envoyer le message</span>
                    </button>
                </form>
            </section>


            <!-- Colonne droite : infos -->
            <aside class="contact-aside">
                <div class="wm-card contact-info-card">
                    <h3 data-i18n="Coordonnées">Coordonnées</h3>
                    <ul class="contact-info-list">
                        <li>
                            <span class="contact-info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            </span>
                            <div>
                                <span class="contact-info-label" data-i18n="Email">Email</span>
                                <a href="mailto:contact@mayoraz-net.ch" class="contact-info-value">contact@mayoraz-net.ch</a>
                            </div>
                        </li>
                        <li>
                            <span class="contact-info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.63 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            </span>
                            <div>
                                <span class="contact-info-label" data-i18n="Téléphone">Téléphone</span>
                                <a href="tel:+41766122053" class="contact-info-value">+41 76 612 20 53</a>
                            </div>
                        </li>
                        <li>
                            <span class="contact-info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            </span>
                            <div>
                                <span class="contact-info-label" data-i18n="Zone">Zone</span>
                                <span class="contact-info-value">Lausanne &amp; environs</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="wm-card contact-info-card">
                    <h3 data-i18n="Réseaux">Réseaux</h3>
                    <ul class="contact-info-list">
                        <li>
                            <span class="contact-info-icon">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
                            </span>
                            <div>
                                <span class="contact-info-label">GitHub</span>
                                <a href="https://github.com/Tom1419-git" target="_blank" rel="noopener" class="contact-info-value">Tom1419-git</a>
                            </div>
                        </li>
                        <li>
                            <span class="contact-info-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                            </span>
                            <div>
                                <span class="contact-info-label">LinkedIn</span>
                                <a href="https://www.linkedin.com/in/thomas-mayoraz-it/" target="_blank" rel="noopener" class="contact-info-value">thomas-mayoraz-it</a>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="wm-card contact-info-card contact-availability">
                    <div class="availability-dot"></div>
                    <div>
                        <p class="availability-title" data-i18n="Disponible à Lausanne">Disponible à Lausanne</p>
                        <p class="availability-sub" data-i18n="Réponse sous 24–48h">Réponse sous 24–48h</p>
                    </div>
                </div>
            </aside>

        </main>
    </div>

    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Contact Thomas Mayoraz",
        "description": "Page de contact pour les services informatiques à Lausanne",
        "url": "https://mayoraz-net.ch/contact/",
        "potentialAction": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "telephone": "+41-076-612-2053",
            "email": "contact@mayoraz-net.ch",
            "areaServed": "Lausanne et région"
        }
    }
    </script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&amp;onload=onloadTurnstileCallback" async="" defer=""></script>
<script is:inline>
    document.addEventListener('astro:page-load', () => {
        // ── Chips génériques (budget + urgence) ──────────────────────────
        document.querySelectorAll('.chip-group').forEach(group => {
            const hidden = group.querySelector('input[type="hidden"]');
            const chips  = group.querySelectorAll('.chip');
            chips.forEach(chip => {
                chip.addEventListener('click', () => {
                    chips.forEach(c => c.classList.remove('active'));
                    chip.classList.add('active');
                    if (hidden) hidden.value = chip.dataset.value;
                });
            });
        });

        // ── Compteur de caractères ────────────────────────────────────────
        const textarea  = document.getElementById('message');
        const charCount = document.getElementById('char-count');
        if (textarea && charCount) {
            textarea.addEventListener('input', () => {
                const len = textarea.value.length;
                charCount.textContent = len;
                charCount.style.color = len > 900 ? '#ff6060' : '';
            });
        }

        // ── Fichier joint — affichage du nom + drag&drop ─────────────────
        const fileInput  = document.getElementById('attachment');
        const fileNameEl = document.getElementById('file-name');
        const fileLabel  = document.querySelector('.file-upload-label');
        if (fileInput && fileNameEl) {
            fileInput.addEventListener('change', () => {
                const f = fileInput.files[0];
                fileNameEl.textContent = f ? '✓ ' + f.name : '';
            });
        }
        if (fileLabel) {
            fileLabel.addEventListener('dragover', e => { e.preventDefault(); fileLabel.classList.add('dragover'); });
            fileLabel.addEventListener('dragleave', () => fileLabel.classList.remove('dragover'));
            fileLabel.addEventListener('drop', e => {
                e.preventDefault();
                fileLabel.classList.remove('dragover');
                if (e.dataTransfer.files.length && fileInput) {
                    fileInput.files = e.dataTransfer.files;
                    fileNameEl.textContent = '✓ ' + e.dataTransfer.files[0].name;
                }
            });
        }

        // ── Soumission du formulaire ──────────────────────────────────────
        const contactForm = document.querySelector('.contact-form');
        if (!contactForm) return;
        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const turnstileInput = document.querySelector('[name="cf-turnstile-response"]');
            if (!turnstileInput || !turnstileInput.value) {
                alert(window.t ? window.t('Veuillez valider le captcha avant d\'envoyer.') : 'Veuillez valider le captcha avant d\'envoyer.');
                return;
            }
            const form      = this;
            const submitBtn = form.querySelector('button[type="submit"]');
            const origHTML  = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span>' + (window.t ? window.t('Envoi en cours...') : 'Envoi en cours...') + '</span>';
            submitBtn.disabled  = true;

            const formData = new FormData(form);
            formData.delete('cf-turnstile-response');

            // On combine prénom + nom
            const prenom = (formData.get('prenom') || '').trim();
            const nom    = (formData.get('nom') || '').trim();
            formData.set('name', [prenom, nom].filter(Boolean).join(' '));
            formData.delete('prenom');
            formData.delete('nom');

            // Note: pour n8n on peut envoyer en FormData (multipart) si on a des fichiers joints !
            // On laisse donc fetch gérer le multipart tout seul.

            fetch('https://n8n.mayoraz-net.ch/webhook/contact-form', {
                method: 'POST',
                body: formData
            }).then(res => {
                if (res.ok) { window.location.href = '/contact/merci/'; }
                else {
                    alert(window.t ? window.t('Erreur lors de l\'envoi via n8n. Veuillez réessayer.') : 'Erreur lors de l\'envoi via n8n. Veuillez réessayer.');
                    submitBtn.innerHTML = origHTML;
                    submitBtn.disabled  = false;
                }
            }).catch(() => {
                alert(window.t ? window.t('Erreur de réseau. Vérifiez votre connexion.') : 'Erreur de réseau. Vérifiez votre connexion.');
                submitBtn.innerHTML = origHTML;
                submitBtn.disabled  = false;
            });
        });
    });
</script>

<script is:inline>
        let turnstileWidgetId = null;

        window.onloadTurnstileCallback = function () {
            renderTurnstile();
        };

        function renderTurnstile() {
            if (typeof turnstile === 'undefined') return;
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            
            if (turnstileWidgetId !== null) {
                turnstile.remove(turnstileWidgetId);
            }
            
            turnstileWidgetId = turnstile.render('#cf-turnstile-container', {
                sitekey: '0x4AAAAAADhc2UTooOzxGXSX',
                theme: currentTheme
            });
        }

        // Observer pour détecter quand le bouton thème est cliqué
        let observer;
        
        document.addEventListener('astro:page-load', () => {
            if (document.getElementById('cf-turnstile-container')) {
                // If script is already loaded
                if (typeof turnstile !== 'undefined') {
                    renderTurnstile();
                }
                
                if (!observer) {
                    observer = new MutationObserver((mutations) => {
                        mutations.forEach((mutation) => {
                            if (mutation.attributeName === 'data-theme') {
                                renderTurnstile();
                            }
                        });
                    });
                    observer.observe(document.documentElement, { attributes: true });
                }
            }
        });
    </script>
    </Fragment>
</Layout>
