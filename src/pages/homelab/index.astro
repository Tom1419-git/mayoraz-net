---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';

// JSON-LD dédié à la page homelab (le Layout émet déjà un Person global)
const homelabSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mayoraz-net.ch/homelab/#webpage",
      "url": "https://mayoraz-net.ch/homelab/",
      "name": "Homelab & Infrastructure - Thomas Mayoraz",
      "description": "Infrastructure personnelle de niveau production : Proxmox, assistant IA d'exploitation (Vektor), indexeur DHT self-hosted, SSO, failover Cloudflare, backups chiffrés et observabilité complète.",
      "inLanguage": "fr",
      "isPartOf": { "@id": "https://mayoraz-net.ch/#website" },
      "about": { "@id": "https://mayoraz-net.ch/#person" },
      "breadcrumb": { "@id": "https://mayoraz-net.ch/homelab/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mayoraz-net.ch/homelab/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://mayoraz-net.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Homelab", "item": "https://mayoraz-net.ch/homelab/" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Composants de l'infrastructure",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Vektor — assistant d'exploitation IA", "url": "https://github.com/Tom1419-git/vektor" },
        { "@type": "ListItem", "position": 2, "name": "Proxmox VE — 11 conteneurs LXC" },
        { "@type": "ListItem", "position": 3, "name": "SSO Authelia (2FA)" },
        { "@type": "ListItem", "position": 4, "name": "Failover Cloudflare Tunnel — 16 vhosts" },
        { "@type": "ListItem", "position": 5, "name": "bitmagnet — indexeur DHT (~200 000 torrents)" },
        { "@type": "ListItem", "position": 6, "name": "Observabilité — Prometheus, Grafana, Loki" },
        { "@type": "ListItem", "position": 7, "name": "Backups chiffrés 3-2-1 — RTO ~12 min" }
      ]
    }
  ]
};
---

<Layout title="Homelab & Infrastructure - Thomas Mayoraz" description="Infrastructure personnelle de niveau production : Proxmox, assistant IA d'exploitation (Vektor), indexeur DHT self-hosted, SSO, failover Cloudflare, backups chiffrés et observabilité complète." cssFile="/media/css/homelab.css">
    <script type="application/ld+json" set:html={JSON.stringify(homelabSchema)} />
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">                <p class="wm-section-eyebrow" data-i18n="Mon Homelab">Mon Homelab</p>
                <h1 class="wm-section-title" data-i18n-html="Infrastructure de Production &amp; Exploitation Assistée par IA" data-i18n="Infrastructure de Production &amp; Exploitation Assistée par IA">Infrastructure de Production &amp; <span class="accent">Exploitation Assistée par IA</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px;" data-i18n="← Retour à l'accueil">← Retour à l'accueil</a>
            </div>
        </header>

        <main style="max-width: 1200px; margin: 0 auto 60px;">
            <section class="wm-card" style="padding: 30px; margin-bottom: 40px; text-align: center;">
                <p style="color: var(--text-heading); line-height: 1.7; font-size: 1.1rem; margin-bottom: 15px;" data-i18n-html="Mon homelab est géré comme un environnement de production : monitoring complet, backups chiffrés testés par des restaurations réelles, procédures de reprise documentées et <strong style='color: var(--accent);'>auto-réparation</strong>. L'exploitation quotidienne est déléguée à Vektor, un assistant IA que j'ai développé, pilotable en langage naturel depuis Telegram.">Mon homelab est géré comme un environnement de production : monitoring complet, backups chiffrés testés par des restaurations réelles, procédures de reprise documentées et <strong style="color: var(--accent);">auto-réparation</strong>. L'exploitation quotidienne est déléguée à Vektor, un assistant IA que j'ai développé, pilotable en langage naturel depuis Telegram.</p>
                <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 0;" data-i18n="L'infrastructure combine un hyperviseur Proxmox hébergeant 11 conteneurs LXC dédiés, un VPS en edge (Caddy + apps publiques) hébergé chez Mystral.ch, un Raspberry Pi pour le DNS/DHCP du LAN et un réseau mesh NetBird pour l'administration. La haute disponibilité est prise au sérieux : tunnel Cloudflare de secours prêt à basculer 16 vhosts, watchdogs auto-réparants, et chaîne d'alerte Telegram sans spam.">L'infrastructure combine un hyperviseur Proxmox hébergeant 11 conteneurs LXC dédiés, un VPS en edge (Caddy + apps publiques) hébergé chez Mystral.ch, un Raspberry Pi pour le DNS/DHCP du LAN et un réseau mesh NetBird pour l'administration. La haute disponibilité est prise au sérieux : tunnel Cloudflare de secours prêt à basculer 16 vhosts, watchdogs auto-réparants, et chaîne d'alerte Telegram sans spam.</p>
            </section>

            <section class="wm-card" style="padding: 40px; margin-bottom: 40px; text-align: center; border-color: rgba(79, 143, 255, 0.3);">
                <h2 style="margin-top:0; margin-bottom: 30px; font-size: 1.5rem; color: var(--text-heading);" data-i18n="Architecture Média Automatisée">Architecture Média Automatisée</h2>
                <div class="flowchart" style="display: flex; flex-direction: column; align-items: center; gap: 15px;">
                    <div class="flow-row">
                        <div class="flow-box" style="display: inline-flex; align-items: center; gap: 9px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent); flex-shrink: 0;" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span data-i18n="Utilisateur (Jellyseerr)">Utilisateur (Jellyseerr)</span></div>
                    </div>
                    <div class="flow-arrow" style="color: var(--accent); font-size: 1.5rem;">↓</div>
                    <div class="flow-row">
                        <div class="flow-box" style="display: inline-flex; align-items: center; gap: 9px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent); flex-shrink: 0;" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg><span data-i18n="Radarr / Sonarr">Radarr / Sonarr</span></div>
                        <div class="flow-arrow horizontal" style="color: var(--accent); font-size: 1.5rem;">↔</div>
                        <div class="flow-box" style="display: inline-flex; align-items: center; gap: 9px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent); flex-shrink: 0;" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span data-i18n="Prowlarr + bitmagnet (DHT)">Prowlarr + bitmagnet (DHT)</span></div>
                    </div>
                    <div class="flow-arrow" style="color: var(--accent); font-size: 1.5rem;">↓</div>
                    <div class="flow-row">
                        <div class="flow-box" style="display: inline-flex; align-items: center; gap: 9px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent); flex-shrink: 0;" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span data-i18n="qBittorrent (suspendu si streaming)">qBittorrent (suspendu si streaming)</span></div>
                    </div>
                    <div class="flow-arrow" style="color: var(--accent); font-size: 1.5rem;">↓</div>
                    <div class="flow-row">
                        <div class="flow-box" style="display: inline-flex; align-items: center; gap: 9px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600; border-color: var(--accent); color: var(--accent);"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg><span data-i18n="Jellyfin (transcodage GPU VAAPI)">Jellyfin (transcodage GPU VAAPI)</span></div>
                    </div>
                </div>
            </section>

            <section>
                <div style="text-align: center; margin-bottom: 10px;">
                    <p class="wm-section-eyebrow" data-i18n="Le projet phare">Le projet phare</p>
                    <h2 class="wm-section-title" data-i18n="Vektor — l'exploitation en langage naturel">Vektor — l'exploitation en <span class="accent">langage naturel</span></h2>
                </div>

                <div class="wm-card" style="padding: 40px; margin-bottom: 40px;">
                    <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.7; margin-bottom: 20px;" data-i18n-html="Vektor est un <strong style='color: var(--accent);'>assistant d'exploitation IA</strong> que j'ai conçu et développé : un bot Telegram connecté à toute l'infrastructure, qui comprend le langage naturel et exécute des opérations réelles — redémarrer un service, diagnostiquer une panne, gérer les mises à jour des conteneurs, produire un rapport matinal complet (backups, santé, conformité, enrichissement de l'indexeur).">Vektor est un <strong style="color: var(--accent);">assistant d'exploitation IA</strong> que j'ai conçu et développé : un bot Telegram connecté à toute l'infrastructure, qui comprend le langage naturel et exécute des opérations réelles — redémarrer un service, diagnostiquer une panne, gérer les mises à jour des conteneurs, produire un rapport matinal complet (backups, santé, conformité, enrichissement de l'indexeur).</p>

                    <div class="wm-bento-grid" style="margin-top: 30px;">
                        <div class="wm-bento-cell col-6">
                            <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                            <span class="cell-title" data-i18n="Sécurité par conception">Sécurité par conception</span>
                            <span class="cell-desc" data-i18n="Toute action d'écriture passe par une double confirmation obligatoire et une whitelist stricte validée côté serveur (SSH à commande forcée). Aucune commande libre : l'IA propose, l'humain confirme.">Toute action d'écriture passe par une double confirmation obligatoire et une whitelist stricte validée côté serveur (SSH à commande forcée). Aucune commande libre : l'IA propose, l'humain confirme.</span>
                        </div>
                        <div class="wm-bento-cell col-6">
                            <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
                            <span class="cell-title" data-i18n="Mémoire vectorielle">Mémoire vectorielle</span>
                            <span class="cell-desc" data-i18n="Conversations et connaissances d'exploitation stockées dans PostgreSQL + pgvector : Vektor se souvient du contexte technique de l'infrastructure et apprend de chaque incident.">Conversations et connaissances d'exploitation stockées dans PostgreSQL + pgvector : Vektor se souvient du contexte technique de l'infrastructure et apprend de chaque incident.</span>
                        </div>
                        <div class="wm-bento-cell col-6">
                            <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="21" y1="10" x2="21" y2="14"/><line x1="3" y1="10" x2="3" y2="14"/><rect x="7" y="4" width="10" height="16" rx="1"/><path d="M3 12h18"/></svg></span>
                            <span class="cell-title" data-i18n="Gestionnaire d'updates Docker">Gestionnaire d'updates Docker</span>
                            <span class="cell-desc" data-i18n="Scan des mises à jour disponibles par stack compose, proposition, confirmation, puis application en live avec rapport détaillé par conteneur — sans jamais toucher aux services critiques (blacklist).">Scan des mises à jour disponibles par stack compose, proposition, confirmation, puis application en live avec rapport détaillé par conteneur — sans jamais toucher aux services critiques (blacklist).</span>
                        </div>
                        <div class="wm-bento-cell col-6">
                            <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></span>
                            <span class="cell-title" data-i18n="CI/CD complet">CI/CD complet</span>
                            <span class="cell-desc" data-i18n="157 tests automatisés verts en CI, releases versionnées, et déploiement en production automatique par watcher à chaque tag. Le bot se déploie lui-même, comme une vraie app SaaS.">157 tests automatisés verts en CI, releases versionnées, et déploiement en production automatique par watcher à chaque tag. Le bot se déploie lui-même, comme une vraie app SaaS.</span>
                        </div>
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 25px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Python</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Telegram Bot API</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">PostgreSQL + pgvector</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Docker Compose</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">GitHub Actions</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">pytest</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">SSH forced-command</span>
                    </div>

                    <div style="margin-top: 25px;">
                        <a class="btn-outline" href="https://github.com/Tom1419-git/vektor" target="_blank" rel="noopener noreferrer" style="display: inline-flex;" data-i18n="→ Code source sur GitHub">→ Code source sur GitHub</a>
                    </div>
                </div>
            </section>

            <section>
                <div style="text-align: center; margin-bottom: 10px;">
                    <p class="wm-section-eyebrow" data-i18n="Infrastructure">Infrastructure</p>
                    <h2 class="wm-section-title" data-i18n="Détails Techniques">Détails <span class="accent">Techniques</span></h2>
                </div>

                <div class="wm-bento-grid">

                    <div class="wm-bento-cell col-6">
                        <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="8" rx="2"/><rect x="2" y="13" width="20" height="8" rx="2"/><line x1="6" y1="7" x2="6.01" y2="7"/><line x1="6" y1="17" x2="6.01" y2="17"/></svg></span>
                        <span class="cell-title" data-i18n="Hyperviseur &amp; Conteneurisation">Hyperviseur &amp; Conteneurisation</span>
                        <span class="cell-desc" data-i18n="Proxmox VE héberge 11 conteneurs LXC dédiés (média, téléchargements, DNS, bases de données, sécurité, indexeur), avec Docker à l'intérieur. Ce cloisonnement limite la propagation d'un problème et rend chaque brique sauvegardable et remplaçable indépendamment.">Proxmox VE héberge 11 conteneurs LXC dédiés (média, téléchargements, DNS, bases de données, sécurité, indexeur), avec Docker à l'intérieur. Ce cloisonnement limite la propagation d'un problème et rend chaque brique sauvegardable et remplaçable indépendamment.</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Proxmox VE</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Docker</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="11 LXC dédiés">11 LXC dédiés</span>
                        </div>
                    </div>

                    <div class="wm-bento-cell col-6">
                        <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
                        <span class="cell-title" data-i18n="Edge &amp; Haute Disponibilité">Edge &amp; Haute Disponibilité</span>
                        <span class="cell-desc" data-i18n="Les services publics passent par un VPS (hébergé chez Mystral.ch) derrière Cloudflare. Un tunnel Cloudflare de secours est armé en permanence : 16 vhosts (SSO inclus) peuvent basculer vers le homelab en un clic. Lors d'une panne datacenter réelle du VPS, le homelab est resté opérationnel de bout en bout.">Les services publics passent par un VPS (hébergé chez Mystral.ch) derrière Cloudflare. Un tunnel Cloudflare de secours est armé en permanence : 16 vhosts (SSO inclus) peuvent basculer vers le homelab en un clic. Lors d'une panne datacenter réelle du VPS, le homelab est resté opérationnel de bout en bout.</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Cloudflare Tunnel</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Caddy</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Mystral.ch</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="16 vhosts failover">16 vhosts failover</span>
                        </div>
                    </div>

                    <div class="wm-bento-cell col-6">
                        <span class="cell-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                        <span class="cell-title" data-i18n="Sécurité &amp; SSO">Sécurité &amp; SSO</span>
                        <span class="cell-desc" data-i18n="Zéro port ouvert sur la box : exposition uniquement via Cloudflare, filtrage par pare-feu par conteneur, administration à distance par réseau mesh NetBird. Tous les services sensibles sont derrière un SSO Authelia (2FA TOTP) via forward_auth, et l'exposition publique est défendue par une détection d'intrusion collaborative (CrowdSec). Audit de conformité CIS-L1 automatisé.">Zéro port ouvert sur la box : exposition uniquement via Cloudflare, filtrage par pare-feu par conteneur, administration à distance par réseau mesh NetBird. Tous les services sensibles sont derrière un SSO Authelia (2FA TOTP) via forward_auth, et l'exposition publique est défendue par une détection d'intrusion collaborative (CrowdSec). Audit de conformité CIS-L1 automatisé.</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="SSO Authelia 2FA">SSO Authelia 2FA</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">NetBird</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">CrowdSec</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">CIS-L1</span>
                        </div>
                    </div>

                    <div class="wm-bento-cell col-6">
