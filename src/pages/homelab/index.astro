---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';
---

<Layout title="Mon Homelab - Thomas Mayoraz | Infrastructure & Automatisation" data-i18n="Mon Homelab - Thomas Mayoraz | Infrastructure & Automatisation" description="Découvrez mon infrastructure personnelle : virtualisation Proxmox, conteneurs Docker, réseau zero-trust et automatisation complète." cssFile="/media/css/homelab.css?v=1782221779">
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">                <p class="wm-section-eyebrow" data-i18n="Mon Homelab">Mon Homelab</p>
                <h1 class="wm-section-title" data-i18n-html="Infrastructure Personnelle &amp; Automatisation" data-i18n="Infrastructure Personnelle &amp; Automatisation">Infrastructure Personnelle &amp; <span class="accent">Automatisation</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px;" data-i18n="← Retour à l'accueil">← Retour à l'accueil</a>
            </div>
        </header>

        <main style="max-width: 1200px; margin: 0 auto 60px;">
            <section class="wm-card" style="padding: 30px; margin-bottom: 40px; text-align: center;">
                <p style="color: var(--text-heading); line-height: 1.7; font-size: 1.1rem; margin-bottom: 15px;" data-i18n-html="En tant que passionné par l'administration système et réseau, j'héberge et je maintiens ma propre infrastructure à domicile. Ce <strong style='color: var(--accent);'>Homelab</strong> est mon laboratoire d'apprentissage continu.">En tant que passionné par l'administration système et réseau, j'héberge et je maintiens ma propre infrastructure à domicile. Ce <strong style="color: var(--accent);">Homelab</strong> est mon laboratoire d'apprentissage continu.</p>
                <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 0;" data-i18n="Tout mon environnement tourne de manière optimisée et isolée, me permettant d'explorer les technologies d'entreprise comme la virtualisation avec Proxmox, la conteneurisation, le monitoring avancé et l'automatisation de processus.">Tout mon environnement tourne de manière optimisée et isolée, me permettant d'explorer les technologies d'entreprise comme la virtualisation avec Proxmox, la conteneurisation, le monitoring avancé et l'automatisation de processus.</p>
            </section>

            <section class="wm-card" style="padding: 40px; margin-bottom: 40px; text-align: center; border-color: rgba(79, 143, 255, 0.3);">
                <h3 style="margin-top:0; margin-bottom: 30px; font-size: 1.5rem; color: var(--text-heading);" data-i18n="Architecture Média Automatisée">Architecture Média Automatisée</h3>
                <div class="flowchart" style="display: flex; flex-direction: column; align-items: center; gap: 15px;">
                    <div class="flow-row">
                        <div class="flow-box" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;" data-i18n="👤 Utilisateur (Jellyseerr)">👤 Utilisateur (Jellyseerr)</div>
                    </div>
                    <div class="flow-arrow" style="color: var(--accent); font-size: 1.5rem;">↓</div>
                    <div class="flow-grid-row" style="display: flex; gap: 20px; align-items: center;">
                        <div class="flow-box center-box" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;" data-i18n="🎬 Radarr / Sonarr">🎬 Radarr / Sonarr</div>
                        <div class="flow-side-branch" style="display: flex; align-items: center; gap: 20px;">
                            <div class="flow-arrow horizontal" style="color: var(--accent); font-size: 1.5rem;">↔</div>
                            <div class="flow-box" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;" data-i18n="🔍 Prowlarr">🔍 Prowlarr</div>
                        </div>
                    </div>
                    <div class="flow-arrow" style="color: var(--accent); font-size: 1.5rem;">↓</div>
                    <div class="flow-row">
                        <div class="flow-box" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600;" data-i18n="📥 qBittorrent">📥 qBittorrent</div>
                    </div>
                    <div class="flow-arrow" style="color: var(--accent); font-size: 1.5rem;">↓</div>
                    <div class="flow-row">
                        <div class="flow-box" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 15px 25px; border-radius: 8px; font-weight: 600; border-color: var(--accent); color: var(--accent);" data-i18n="🍿 Jellyfin">🍿 Jellyfin</div>
                    </div>
                </div>
            </section>

            <section>
                <div style="text-align: center; margin-bottom: 40px;">
                    <p class="wm-section-eyebrow" data-i18n="Infrastructure">Infrastructure</p>
                    <h2 class="wm-section-title" data-i18n="Détails Techniques de l'Infrastructure">Détails <span class="accent">Techniques</span></h2>
                </div>
                
                <div class="wm-bento-grid">
                    
                    <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                        <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 15px 0; display: flex; align-items: center; gap: 10px;" data-i18n="🖥️ Hyperviseur &amp; Conteneurisation">🖥️ Hyperviseur &amp; Conteneurisation</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Mon infrastructure repose sur l'hyperviseur Proxmox VE : chaque famille de services tourne dans son propre conteneur LXC dédié (média, téléchargements, automatisation, bases de données, sécurité), virtualisé avec Docker à l'intérieur. Ce cloisonnement limite la propagation d'un problème et rend chaque brique sauvegardable et remplaçable indépendamment.">Mon infrastructure repose sur l'hyperviseur Proxmox VE : chaque famille de services tourne dans son propre conteneur LXC dédié (média, téléchargements, automatisation, bases de données, sécurité), virtualisé avec Docker à l'intérieur. Ce cloisonnement limite la propagation d'un problème et rend chaque brique sauvegardable et remplaçable indépendamment.</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Proxmox VE</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Docker</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Conteneurs LXC dédiés">Conteneurs LXC dédiés</span>
                        </div>
                    </div>

                    <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                        <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 15px 0; display: flex; align-items: center; gap: 10px;" data-i18n="💾 Stockage &amp; Optimisation Hardlinks">💾 Stockage &amp; Optimisation Hardlinks</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="La gestion du stockage exploite MergerFS pour fusionner plusieurs disques physiques en un pool unique de 4 To. L'architecture de mes volumes Docker est strictement alignée sur les standards de l'industrie (TRaSH Guides), permettant l'utilisation de Hardlinks : les transferts entre les outils de téléchargement et la librairie média (Jellyfin) sont instantanés et ne dupliquent aucune donnée.">La gestion du stockage exploite MergerFS pour fusionner plusieurs disques physiques en un pool unique de 4 To. L'architecture de mes volumes Docker est strictement alignée sur les standards de l'industrie (TRaSH Guides), permettant l'utilisation de Hardlinks : les transferts entre les outils de téléchargement et la librairie média (Jellyfin) sont instantanés et ne dupliquent aucune donnée.</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">MergerFS (4To)</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Atomic Moves</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">TRaSH Guides</span>
                        </div>
                    </div>

                    <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                        <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 15px 0; display: flex; align-items: center; gap: 10px;" data-i18n="🌐 Réseau Zero-Trust &amp; Proxy">🌐 Réseau Zero-Trust &amp; Proxy</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="L'architecture réseau applique le principe du moindre privilège : zéro port ouvert sur la box, exposition Internet uniquement via tunnel Cloudflare, et filtrage par pare-feu au niveau de chaque conteneur. Le DNS du réseau local passe par des résolveurs redondants avec blocage de publicités (Pi-hole), et l'accès aux interfaces d'administration est protégé par une authentification à deux facteurs (Authelia + TOTP). L'administration distance se fait par réseau privé virtuel (NetBird), jamais par port exposé.">L'architecture réseau applique le principe du moindre privilège : zéro port ouvert sur la box, exposition Internet uniquement via tunnel Cloudflare, et filtrage par pare-feu au niveau de chaque conteneur. Le DNS du réseau local passe par des résolveurs redondants avec blocage de publicités (Pi-hole), et l'accès aux interfaces d'administration est protégé par une authentification à deux facteurs (Authelia + TOTP). L'administration distance se fait par réseau privé virtuel (NetBird), jamais par port exposé.</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Cloudflare Tunnel</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Caddy</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Pi-hole</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="2FA Authelia">2FA Authelia</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">NetBird</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Pare-feu par conteneur">Pare-feu par conteneur</span>
                        </div>
                    </div>

                    <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                        <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 15px 0; display: flex; align-items: center; gap: 10px;" data-i18n="🛡️ Résilience &amp; Infrastructure as Code">🛡️ Résilience &amp; Infrastructure as Code</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="La pérennité repose sur la règle 3-2-1 : copies locales sur un pool redondant, copies chiffrées côté client vers le cloud (rclone crypt), et vérifications automatiques quotidiennes qui alertent sur Telegram si un backup échoue ou qu'une machine ne répond plus (dead man's switch). L'exposition publique est en plus défendue par une détection d'intrusion collaborative (CrowdSec) qui bloque les IP malveillantes avant qu'elles n'atteignent les services.">La pérennité repose sur la règle 3-2-1 : copies locales sur un pool redondant, copies chiffrées côté client vers le cloud (rclone crypt), et vérifications automatiques quotidiennes qui alertent sur Telegram si un backup échoue ou qu'une machine ne répond plus (dead man's switch). L'exposition publique est en plus défendue par une détection d'intrusion collaborative (CrowdSec) qui bloque les IP malveillantes avant qu'elles n'atteignent les services.</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Backups chiffrés 3-2-1">Backups chiffrés 3-2-1</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Dead man's switch">Dead man's switch</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Grafana · Loki</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">CrowdSec</span>
                        </div>
                    </div>
                    
                    <div class="wm-bento-cell" style="grid-column: 1 / -1; display: flex; flex-direction: column;">
                        <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 15px 0; display: flex; align-items: center; gap: 10px;" data-i18n="📈 Observabilité & Auto-résolution (n8n)">📈 Observabilité &amp; Auto-résolution (n8n)</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="L'automatisation est poussée à son paroxysme avec n8n : en cas d'anomalie détectée sur le serveur, des workflows automatisés (Auto-Healing) communiquent avec l'API Docker pour redémarrer ou reconfigurer les services défaillants de manière autonome.">L'automatisation est poussée à son paroxysme avec n8n : en cas d'anomalie détectée sur le serveur, des workflows automatisés (Auto-Healing) communiquent avec l'API Docker pour redémarrer ou reconfigurer les services défaillants de manière autonome.</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">n8n Workflow</span>
                            <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">Auto-Healing</span>
                        </div>
                    </div>
                    
                </div>
            </section>
            <ContactCta />
        </main>
    </div>
    
</Layout>
