---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Projets C# - Thomas Mayoraz | Services Informatiques Lausanne" description="Mes projets de développement en C# : applications console, jeux et solutions logicielles. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">
                <div class="avatar">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" />
                    <div class="avatar-fallback">TM</div>
                </div>
                <h1 data-i18n="Projets C#">Projets C#</h1>
                <p class="subtitle" data-i18n="Mes développements et applications en C#">Mes développements et applications en C#</p>
                <a class="back-nav" href="/">← Retour au Portfolio</a>
            </div>
        </header>

        <main>
            <section class="intro reveal">
                <p data-i18n="Découvrez mes projets développés en C#, des applications console aux interfaces graphiques. Chaque projet représente un défi technique relevé et une compétence acquise.">Découvrez mes projets développés en C#, des applications console aux interfaces graphiques. Chaque projet représente un défi technique relevé et une compétence acquise.</p>
            </section>

            <div class="projects-grid">
                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">🔴</span>
                            <div>
                                <h3 class="project-title" data-i18n="Puissance 4">Puissance 4</h3>
                                <p class="project-type" data-i18n="Application Console">Application Console</p>
                                <p class="project-date" data-i18n="Octobre 2024">Octobre 2024</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description" data-i18n="Jeu de Puissance 4 classique développé en C# pour la console. Deux joueurs s'affrontent pour aligner 4 jetons de leur couleur horizontalement, verticalement ou en diagonale. Le jeu inclut une grille interactive, la détection des victoires et la gestion des tours.">
                        Jeu de Puissance 4 classique développé en C# pour la console. Deux joueurs s'affrontent pour aligner 4 jetons de leur couleur horizontalement, verticalement ou en diagonale. Le jeu inclut une grille interactive, la détection des victoires et la gestion des tours.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag">C#</span>
                        <span class="tech-tag" data-i18n="Console App">Console App</span>
                        <span class="tech-tag" data-i18n="Jeu">Jeu</span>
                        <span class="tech-tag" data-i18n="Logique">Logique</span>
                    </div>
                    <div class="project-actions">
                        <a href="./puissance4/Puissance4.exe" class="download-btn" download="" data-i18n="📥 Télécharger .exe">
                            📥 Télécharger .exe
                        </a>
                    </div>
                </div>

                <div class="project-card reveal">
                    <div class="project-header">
                        <div class="project-title-section">
                            <span class="project-icon">🎯</span>
                            <div>
                                <h3 class="project-title" data-i18n="Mastermind">Mastermind</h3>
                                <p class="project-type" data-i18n="Application Console">Application Console</p>
                                <p class="project-date" data-i18n="Juin 2025">Juin 2025</p>
                            </div>
                        </div>
                        <div class="project-status" data-i18n="TERMINÉ">TERMINÉ</div>
                    </div>
                    <p class="project-description" data-i18n="Implémentation complète du jeu Mastermind en C#. Le joueur doit deviner une combinaison secrète de couleurs en un nombre limité d'essais. L'application fournit des indices après chaque tentative et gère différents niveaux de difficulté.">
                        Implémentation complète du jeu Mastermind en C#. Le joueur doit deviner une combinaison secrète de couleurs en un nombre limité d'essais. L'application fournit des indices après chaque tentative et gère différents niveaux de difficulté.
                    </p>
                    <div class="project-tech">
                        <span class="tech-tag">C#</span>
                        <span class="tech-tag" data-i18n="Console App">Console App</span>
                        <span class="tech-tag" data-i18n="Algorithmique">Algorithmique</span>
                        <span class="tech-tag" data-i18n="Jeu">Jeu</span>
                    </div>
                    <div class="project-actions">
                        <a href="./mastermind/Mastermind.exe" class="download-btn" download="" data-i18n="📥 Télécharger .exe">
                            📥 Télécharger .exe
                        </a>
                    </div>
                </div>

                <div class="add-project-card">
                    <div class="add-icon">+</div>
                    <p class="add-text" data-i18n="Prochain projet C# en développement...">Prochain projet C# en développement...</p>
                </div>
            </div>
        </main>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Projets C#",
        "description": "Collection de projets développés en C# par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/projets-csharp/",
        "numberOfItems": 2,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "SoftwareApplication",
                    "name": "Puissance 4",
                    "applicationCategory": "Game",
                    "operatingSystem": "Windows"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "SoftwareApplication",
                    "name": "Mastermind",
                    "applicationCategory": "Game",
                    "operatingSystem": "Windows"
                }
            }
        ]
    }
    </script>
    </Fragment>
</Layout>
