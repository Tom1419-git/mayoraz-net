---
import { Image } from 'astro:assets';
import portraitImg from '../../assets/img/portrait.webp';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Projets C# - Thomas Mayoraz | Services Informatiques Lausanne" data-i18n="Projets C# - Thomas Mayoraz | Services Informatiques Lausanne" description="Mes projets de développement en C# : applications console, jeux et solutions logicielles. Thomas Mayoraz, expert en services informatiques à Lausanne.">
    <div class="wm-container" style="padding-top: 60px;">
        <header style="margin-bottom: 40px; text-align: center;">
            <div class="profile-section">
                <div class="avatar" style="width: 100px; height: 100px; margin: 0 auto 20px; border-radius: 50%; overflow: hidden; border: 2px solid var(--glass-border);">
                    <Image src={portraitImg} alt="Portrait de Thomas Mayoraz" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <p class="wm-section-eyebrow" data-i18n="Projets C#">Projets C#</p>
                <h1 class="wm-section-title" data-i18n="Mes développements et applications en C#">Mes développements et applications en <span class="accent">C#</span></h1>
                <a class="btn-outline" href="/" style="display: inline-flex; margin-top: 10px;" data-i18n="← Retour au Portfolio">← Retour au Portfolio</a>
            </div>
        </header>

        <main style="max-width: 1000px; margin: 0 auto 60px;">
            <section class="wm-card" style="padding: 30px; margin-bottom: 40px; text-align: center;">
                <p style="color: var(--text-heading); line-height: 1.7; font-size: 1.1rem; margin-bottom: 0;" data-i18n="Découvrez mes projets développés en C#, des applications console aux interfaces graphiques. Chaque projet représente un défi technique relevé et une compétence acquise.">Découvrez mes projets développés en C#, des applications console aux interfaces graphiques. Chaque projet représente un défi technique relevé et une compétence acquise.</p>
            </section>

            <div class="wm-bento-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
                <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <span style="font-size: 2.5rem;">🔴</span>
                            <div>
                                <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 4px 0;" data-i18n="Puissance 4">Puissance 4</h3>
                                <p style="color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0;" data-i18n="Application Console">Application Console</p>
                                <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;" data-i18n="Octobre 2024">Octobre 2024</p>
                            </div>
                        </div>
                        <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;" data-i18n="TERMINÉ">TERMINÉ</span>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Jeu de Puissance 4 classique développé en C# pour la console. Deux joueurs s'affrontent pour aligner 4 jetons de leur couleur horizontalement, verticalement ou en diagonale. Le jeu inclut une grille interactive, la détection des victoires et la gestion des tours.">
                        Jeu de Puissance 4 classique développé en C# pour la console. Deux joueurs s'affrontent pour aligner 4 jetons de leur couleur horizontalement, verticalement ou en diagonale. Le jeu inclut une grille interactive, la détection des victoires et la gestion des tours.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">C#</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Console App">Console App</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Jeu">Jeu</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Logique">Logique</span>
                    </div>
                    <div style="display: flex;">
                        <a href="./puissance4/Puissance4.exe" class="btn-accent" style="width: 100%; justify-content: center; display: inline-flex;" download="" data-i18n="📥 Télécharger .exe">
                            📥 Télécharger .exe
                        </a>
                    </div>
                </div>

                <div class="wm-bento-cell" style="display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <span style="font-size: 2.5rem;">🎯</span>
                            <div>
                                <h3 style="color: var(--text-heading); font-size: 1.2rem; margin: 0 0 4px 0;" data-i18n="Mastermind">Mastermind</h3>
                                <p style="color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0;" data-i18n="Application Console">Application Console</p>
                                <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;" data-i18n="Juin 2025">Juin 2025</p>
                            </div>
                        </div>
                        <span style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;" data-i18n="TERMINÉ">TERMINÉ</span>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;" data-i18n="Implémentation complète du jeu Mastermind en C#. Le joueur doit deviner une combinaison secrète de couleurs en un nombre limité d'essais. L'application fournit des indices après chaque tentative et gère différents niveaux de difficulté.">
                        Implémentation complète du jeu Mastermind en C#. Le joueur doit deviner une combinaison secrète de couleurs en un nombre limité d'essais. L'application fournit des indices après chaque tentative et gère différents niveaux de difficulté.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;">
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);">C#</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Console App">Console App</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Algorithmique">Algorithmique</span>
                        <span style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; color: var(--text-main);" data-i18n="Jeu">Jeu</span>
                    </div>
                    <div style="display: flex;">
                        <a href="./mastermind/Mastermind.exe" class="btn-accent" style="width: 100%; justify-content: center; display: inline-flex;" download="" data-i18n="📥 Télécharger .exe">
                            📥 Télécharger .exe
                        </a>
                    </div>
                </div>

                <div class="wm-bento-cell" style="display: flex; align-items: center; justify-content: center; min-height: 200px; border: 1px dashed rgba(255,255,255,0.2); background: transparent;">
                    <div style="text-align: center;">
                        <div style="font-size: 2rem; color: var(--accent); margin-bottom: 10px;">+</div>
                        <p style="color: var(--text-muted); font-size: 0.9rem;" data-i18n="Prochain projet C# en développement...">Prochain projet C# en développement...</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
    
    <Fragment slot="scripts">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Projets C#",
        "description": "Collection de projets développés en C# par Thomas Mayoraz",
        "url": "https://mayoraz-net.ch/projets-csharp/",
        "numberOfItems": 2,
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "item": {
                    "@type": "SoftwareApplication",
                    "name": "Puissance 4",
                    "applicationCategory": "Game",
                    "operatingSystem": "Windows"
                }
            },
            {
                "@type": "ListItem",
                "position": 2,
                "item": {
                    "@type": "SoftwareApplication",
                    "name": "Mastermind",
                    "applicationCategory": "Game",
                    "operatingSystem": "Windows"
                }
            }
        ]
    }
    </script>
    </Fragment>
</Layout>
