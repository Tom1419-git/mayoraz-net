            <span class="icon"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg></span>
            <div data-i18n="Montage PC">Montage PC</div>
          </a>
          <a href="/contact/" class="service-item reveal" aria-label="Dépannage informatique à domicile" data-i18n-aria="Dépannage informatique à domicile" style="text-decoration: none;">
            <span class="icon"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span>
            <div data-i18n="Dépannage">Dépannage</div>
          </a>
          <a href="/contact/" class="service-item reveal" aria-label="Conseils techniques personnalisés" data-i18n-aria="Conseils techniques personnalisés" style="text-decoration: none;">
            <span class="icon"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.2 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg></span>
            <div data-i18n="Conseil Technique">Conseil Technique</div>
          </a>
        </div>
      </div>

      <h2 data-i18n="Ma Stack Technique">Ma Stack Technique</h2>
      <div class="skills-matrix">
        
        <!-- Infra & Virtualisation -->
        <div class="skill-category reveal">
          <h3 data-i18n="Infra & Virtualisation">Infra &amp; Virtualisation</h3>
          <div class="skills-grid">
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/proxmox" alt="Proxmox" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Proxmox">Proxmox</span>
              <div class="skill-tooltip" data-i18n="Virtualisation de mes serveurs et gestion de l'infrastructure.">Virtualisation de mes serveurs et gestion de l'infrastructure.</div>
            </div>
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/docker" alt="Docker" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Docker">Docker</span>
              <div class="skill-tooltip" data-i18n="Conteneurisation et déploiement de tous mes services.">Conteneurisation et déploiement de tous mes services.</div>
            </div>
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/ubuntu" alt="Ubuntu" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Ubuntu Linux">Ubuntu Linux</span>
              <div class="skill-tooltip" data-i18n="Administration serveur quotidienne en ligne de commande.">Administration serveur quotidienne en ligne de commande.</div>
            </div>
          </div>
        </div>

        <!-- Monitoring & Automatisation -->
        <div class="skill-category reveal">
          <h3 data-i18n="Monitoring & Auto.">Monitoring &amp; Auto.</h3>
          <div class="skills-grid">
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/n8n" alt="n8n" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="n8n">n8n</span>
              <div class="skill-tooltip" data-i18n="Création de workflows d'auto-healing et notifications.">Création de workflows d'auto-healing et notifications.</div>
            </div>
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/git" alt="Git" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Git">Git</span>
              <div class="skill-tooltip" data-i18n="Versionnage de mes configurations (IaC basique).">Versionnage de mes configurations (IaC basique).</div>
            </div>
          </div>
        </div>

        <!-- Services & Hébergement -->
        <div class="skill-category reveal">
          <h3 data-i18n="Services & Hébergement">Services &amp; Hébergement</h3>
          <div class="skills-grid">
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/jellyfin" alt="Jellyfin" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Media Server">Media Server</span>
              <div class="skill-tooltip" data-i18n="Automatisation complète de la gestion multimédia.">Automatisation complète de la gestion multimédia.</div>
            </div>
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/nginxproxymanager" alt="Nginx" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Nginx Proxy">Nginx Proxy</span>
              <div class="skill-tooltip" data-i18n="Gestion des accès externes sécurisés et redirections.">Gestion des accès externes sécurisés et redirections.</div>
            </div>
            <div class="skill-item">
              <img src="https://cdn.simpleicons.org/cloudflare" alt="Cloudflare" class="skill-icon" width="32" height="32" loading="lazy">
              <span class="skill-name" data-i18n="Cloudflare">Cloudflare</span>
              <div class="skill-tooltip" data-i18n="Sécurisation DNS, cache, certificats SSL et tunnels.">Sécurisation DNS, cache, certificats SSL et tunnels.</div>
            </div>
          </div>
        </div>

      </div>

      <h2 data-i18n="Mes différents projets">Mes différents projets</h2>
      <div class="projects-grid">
