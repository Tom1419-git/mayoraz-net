---
import { Image } from 'astro:assets';
import portraitImg from '../assets/img/portrait.webp';
import Layout from '../layouts/Layout.astro';

const buildHash = Date.now().toString(36);
---

<Layout title="Thomas Mayoraz - Services Informatiques Lausanne | Développement Web & Montage PC" data-i18n="Thomas Mayoraz - Services Informatiques Lausanne | Développement Web & Montage PC" description="Services informatiques à Lausanne : développement web, montage PC et dépannage. Thomas Mayoraz, expert ETML. Solutions sur mesure pour particuliers et professionnels." cssFile="/media/css/index.css">
    <header style="padding: 120px 0 80px; text-align: center; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh;">
      
      <!-- Badge -->
      <a href="/contact/" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 6px 16px; border-radius: 9999px; font-size: 0.85rem; color: var(--text-main); text-decoration: none; margin-bottom: 30px; transition: var(--transition);" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">
        <span style="background: var(--text-heading); color: var(--bg-dark); padding: 2px 8px; border-radius: 9999px; font-weight: 600; font-size: 0.75rem;" data-i18n="Nouveau">Nouveau</span>
        <span data-i18n="Découvrez mes services IT">Découvrez mes services IT</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>

      <!-- Headline -->
      <h1 style="margin-bottom: 24px;">Thomas Mayoraz</h1>
      <div id="typewriter" class="typewriter-text" style="font-size: clamp(1.5rem, 3vw, 2.5rem); font-family: 'Inter', sans-serif; font-weight: 700; color: var(--text-heading); margin-bottom: 24px; min-height: 40px;"></div>
      
      <!-- Subtitle -->
      <p style="font-size: 1.25rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 40px; line-height: 1.6;" data-i18n="Spécialisé dans les services informatiques à Lausanne, je propose des solutions sur mesure pour particuliers et entreprises.">Spécialisé dans les services informatiques à Lausanne, je propose des solutions sur mesure pour particuliers et entreprises.</p>
      
      <!-- CTA Buttons -->
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/contact/" class="btn-primary" data-i18n="Me Contacter">Me Contacter</a>
        <a href="https://github.com/Tom1419-git" target="_blank" class="cta-button">
          <svg height="18" width="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="margin-right: 8px;">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          GitHub
        </a>
      </div>
    </header>

    <main>



      <div class="services-highlight">
        <h3 data-i18n="Mes Services Informatiques dans la région de Lausanne">Mes Services Informatiques dans la région de Lausanne</h3>
        <div class="services-grid">
          <a href="/sites-web/" class="service-item reveal" aria-label="Développement de sites web" data-i18n-aria="Développement de sites web" style="text-decoration: none;">
            <span class="icon"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg></span>
            <div data-i18n="Sites Web">Sites Web</div>
          </a>
