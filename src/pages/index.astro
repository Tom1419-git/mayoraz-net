---
import Layout from '../layouts/Layout.astro';
import ContactCta from '../components/ContactCta.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import Services from '../components/home/Services.astro';
import CaseStudies from '../components/home/CaseStudies.astro';
import Method from '../components/home/Method.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Stack from '../components/home/Stack.astro';

const buildHash = Date.now().toString(36);
---
<Layout
  title="Sites web & dépannage informatique à Lausanne | Thomas Mayoraz"
  description="Sites web rapides, dépannage informatique et PC sur mesure pour les PME et particuliers de Lausanne. Un interlocuteur unique, réponse sous 24 h, devis gratuit."
  cssFile="/media/css/index.css"
>
  <Hero />
  <TrustBar />
  <Services />
  <CaseStudies />
  <Method />
  <Testimonials />
  <Stack />
  <ContactCta
    title="Un projet en tête ?"
    text="Site web, dépannage ou PC sur mesure : décrivez-moi votre besoin, je vous réponds sous 24 h avec une proposition claire."
  />

  <Fragment slot="scripts">
    <script is:inline src={`/media/js/typewriter.js?v=${buildHash}`} defer></script>
  </Fragment>
</Layout>
