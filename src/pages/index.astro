        </div>
        <h1>Thomas Mayoraz</h1>
      <div id="typewriter" class="typewriter-text"></div>
        <p class="subtitle" data-i18n="Services Informatiques Professionnels">Services Informatiques Professionnels</p>
        <p class="location" data-i18n="📍 Lausanne, Vaud • Apprenti Informatique ETML">📍 Lausanne, Vaud • Apprenti Informatique ETML</p>
