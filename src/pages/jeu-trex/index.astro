---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin T-Rex - Thomas Mayoraz | Jeu Caché" description="Mini-jeu caché T-Rex version SysAdmin. Évitez les pannes réseau !" cssFile="trex.css?v=1782221779">
    <header style="margin-bottom: 20px;">
            <div class="profile-section">
                <div class="avatar">
                    <img src="/media/img/portrait.webp" alt="Portrait de Thomas Mayoraz" loading="lazy">
                    <div class="avatar-fallback">TM</div>
                </div>
                <h1>Admin Run</h1>
                <p class="subtitle">Mission : Maintenir le serveur en ligne !</p>
                <a class="back-nav" href="/">← Retour à l'accueil</a>
            </div>
        </header>

        <main>
            <section class="game-section reveal">
                <div class="game-container">
                    <div class="score-board">
                        <span>Score: <span id="current-score">0</span></span>
                        <div style="display: flex; gap: 15px; align-items: center;"><span>Record: <span id="high-score">0</span></span><button id="fullscreen-btn" aria-label="Plein écran" style="background:none; border:none; color:var(--primary); cursor:pointer; display:flex; align-items:center; padding: 0;" title="Plein écran (F)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg></button></div>
                    </div>
                    <canvas id="gameCanvas" width="800" height="300"></canvas>
                    
                    <div id="start-overlay" class="game-overlay">
                        <h2>Prêt à courir ?</h2>
                        <p>Appuyez sur <kbd>Espace</kbd> ou touchez l'écran pour sauter.</p>
                        <p>Évitez les Routeurs en feu (🔥) et les Bugs (🐛) !</p>
                        
                        <div class="difficulty-selector" style="margin: 15px 0; display: flex; gap: 10px; justify-content: center;">
                            <button class="diff-btn" data-speed="3" style="padding: 5px 15px; border-radius: 5px; border: 1px solid #1e90ff; background: transparent; color: #1e90ff; cursor: pointer;">Lent</button>
                            <button class="diff-btn active" data-speed="4" style="padding: 5px 15px; border-radius: 5px; border: 1px solid #1e90ff; background: #1e90ff; color: #fff; cursor: pointer;">Normal</button>
                            <button class="diff-btn" data-speed="5.5" style="padding: 5px 15px; border-radius: 5px; border: 1px solid #ff4500; background: transparent; color: #ff4500; cursor: pointer;">Rapide</button>
                        </div>

                        <button id="start-btn" class="cta-button">Lancer le script</button>
                    </div>
                    
                    <div id="game-over-overlay" class="game-overlay hidden">
                        <h2>⚠️ KERNEL PANIC ⚠️</h2>
                        <p>Le serveur a crashé !</p>
                        <p>Score final : <span id="final-score">0</span></p>
                        <button id="restart-btn" class="cta-button">Reboot Server</button>
                    </div>
                </div>
            </section>
        </main>
    
    <Fragment slot="scripts">
        <script is:inline src="trex.js?v=1782221779"></script>
    </Fragment>
</Layout>
