---
import { ClientRouter } from 'astro:transitions';

export interface Props {
	title: string;
	description?: string;
	cssFile?: string;
	robots?: string;
}

const { 
	title, 
	description = "Services informatiques professionnels à Lausanne : développement web, montage PC et dépannage.", 
	cssFile,
	robots = "index, follow"
} = Astro.props;

// Cache-buster: string unique généré à chaque build pour forcer le rafraîchissement du cache navigateur
const buildHash = Date.now().toString(36);
---
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <script is:inline>
  (function() {
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = saved || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="robots" content={robots}/>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/media/img/logo.webp"/>
    
    <!-- Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph & Twitter -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content="https://mayoraz-net.ch/media/img/og_banner.png"/>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mayoraz-net.ch/media/img/og_banner.png" />

    <!-- JSON-LD (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Thomas Mayoraz",
      "jobTitle": "Développeur & Technicien IT",
      "url": "https://mayoraz-net.ch",
      "sameAs": [
        "https://github.com/Tom1419-git",
        "https://linkedin.com/in/thomas-mayoraz"
      ]
    })}></script>

    <!-- CSS -->
    <link rel="stylesheet" href={`/media/css/main.css?v=${buildHash}`}>
    {cssFile && <link rel="stylesheet" href={`${cssFile}?v=${buildHash}`} />}
    <link rel="stylesheet" href={`/media/css/toast.css?v=${buildHash}`}>
    <link rel="stylesheet" href={`/media/css/terminal.css?v=${buildHash}`}>
    <ClientRouter />
    
    <!-- Analytics (Microsoft Clarity) - GDPR Compliant -->
    <script type="text/javascript" is:inline>
        window.initClarity = function() {
            if(window.clarityLoaded) return;
            window.clarityLoaded = true;
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "sesu01ppfw");
        };

        // Initialize immediately if cookies were already accepted
        if (localStorage.getItem('cookies_accepted') === 'true') {
            window.initClarity();
        }
    </script>
</head>
<body>
    <canvas id="particles-bg"></canvas>

    <nav class="main-nav">
        <div class="nav-overlay" id="nav-overlay"></div>
        <div class="nav-container">
            <a class='logo' href="/">Thomas Mayoraz</a>
            <ul class="nav-links" id="nav-links">
                <li><a href="/" data-i18n="Accueil">Accueil</a></li>
                <li><a href='/a-propos/' data-i18n="À propos">À propos</a></li>
                <li><a href="/tutoriels/" data-i18n="Tutoriels">Tutoriels</a></li>
                <li><a href='/contact/' data-i18n="Contact">Contact</a></li>
                <select id="lang-select" class="lang-select" aria-label="Changer de langue" data-i18n-aria="Changer de langue">
                    <option value="FR">FR</option>
                    <option value="EN">EN</option>
                    <option value="DE">DE</option>
                </select>
                <button id="theme-toggle" class="theme-toggle" aria-label="Changer le thème" data-i18n-aria="Changer le thème">☀️</button>
            </ul>
            <div class="burger" id="burger">
                <span></span><span></span><span></span>
            </div>
        </div>
    </nav>

    <div class="container" transition:animate="slide">
        <slot />

        <footer>
            <p>&copy; {new Date().getFullYear()} Thomas Mayoraz | <a href="https://status.mayoraz-net.ch/status/home" target="_blank" rel="noopener noreferrer" class="status-badge" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: color-mix(in srgb, var(--bg-dark) 50%, transparent); padding: 4px 12px; border-radius: 15px; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); transition: all 0.3s ease; color: var(--text-main); font-size: 0.85rem; font-weight: 600; vertical-align: middle; margin-left: 5px;"><span id="status-indicator" style="width: 10px; height: 10px; border-radius: 50%; background-color: #555; transition: all 0.5s ease;"></span><span id="status-text" data-i18n="Vérification...">Vérification...</span></a></p>
            <nav>
              <a href="/" data-i18n="Accueil">Accueil</a>
              <a href="/a-propos/" data-i18n="À propos">À propos</a>
              <a href="/tutoriels/" data-i18n="Tutoriels">Tutoriels</a>
              <a href="/links/" data-i18n="Liens">Liens</a>
              <a href="/contact/" data-i18n="Contact">Contact</a>
              <!--email_off-->
              <a href="mailto:contact@mayoraz-net.ch">contact@mayoraz-net.ch</a>
              <!--/email_off-->
            </nav>
        </footer>
    </div>

    <button id="backToTop" aria-label="Retour en haut de page" data-i18n-aria="Retour en haut de page">&#8593;</button>

    <script is:inline src={`/media/js/theme.js?v=${buildHash}`}></script>
    <script is:inline src={`/media/js/particles.js?v=${buildHash}`} defer></script>
    <script is:inline src={`/media/js/toast.js?v=${buildHash}`} defer></script>
    <script is:inline src={`/media/js/terminal.js?v=${buildHash}`} defer></script>
    <script is:inline src={`/media/locales/en.js?v=${buildHash}`}></script>
    <script is:inline src={`/media/locales/de.js?v=${buildHash}`}></script>
    <script is:inline src={`/media/js/lang.js?v=${buildHash}`}></script>
    <script is:inline src={`/media/js/konami.js?v=${buildHash}`} defer></script>
    <script is:inline src={`/media/js/status.js?v=${buildHash}`} defer></script>
    <slot name="scripts" />
</body>
</html>
